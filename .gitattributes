# Normaliza finales de línea: LF en el repositorio, CRLF solo en Windows local.
* text=auto

# Lenguajes del proyecto: siempre texto
*.cs text
*.xaml text
*.csproj text
*.sln text
*.md text
*.json text
*.yml text
*.yaml text
*.py text

# Binarios: nunca convertir finales de línea ni hacer diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
