<UserControl x:Class="SITBIO_Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             d:DesignHeight="880" d:DesignWidth="1440"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Panel de marca ================= -->
        <Border Grid.Column="0" Padding="56,48">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#06425F" Offset="0"/>
                    <GradientStop Color="#0B6FA4" Offset="0.55"/>
                    <GradientStop Color="#12B5A6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logotipo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Width="46" Height="46" CornerRadius="13" Background="#FFFFFF" Opacity="0.16">
                        <TextBlock Text="&#xE95E;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SITBIO" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Sistema de Información Técnica y Biomédica" FontSize="11.5"
                                   Foreground="#BFE6F2" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Propuesta de valor -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="Control, trazabilidad y gestión de&#x0a;mantenimientos de equipos biomédicos"
                               FontSize="33" FontWeight="SemiBold" Foreground="White"
                               TextWrapping="Wrap" LineHeight="42"/>

                    <TextBlock Text="Centralice la hoja de vida de sus activos, asigne órdenes de trabajo con código único de seguimiento y obtenga indicadores exportables listos para auditoría."
                               FontSize="14.5" Foreground="#CFE9F5" TextWrapping="Wrap"
                               Margin="0,20,0,0" LineHeight="23"/>

                    <StackPanel Margin="0,34,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                            <Border Width="26" Height="26" CornerRadius="8" Background="#FFFFFF" Opacity="0.2">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Trazabilidad del 100 % de las solicitudes de mantenimiento"
                                       FontSize="13.5" Foreground="White" Margin="11,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                            <Border Width="26" Height="26" CornerRadius="8" Background="#FFFFFF" Opacity="0.2">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Aislamiento multi-tenant y control de acceso por rol (RBAC)"
                                       FontSize="13.5" Foreground="White" Margin="11,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="8" Background="#FFFFFF" Opacity="0.2">
                                <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Reportes PDF y Excel conforme a la Resolución 3100 de 2019"
                                       FontSize="13.5" Foreground="White" Margin="11,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Centro de la Tecnología y Manufactura Avanzada (CTMA) · SENA · ADSO 2026"
                           FontSize="11.5" Foreground="#A9DCEE" Opacity="0.9"/>
            </Grid>
        </Border>

        <!-- ================= Formulario de acceso ================= -->
        <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="420" Margin="48,40,48,40" HorizontalAlignment="Center">

                    <TextBlock Text="Bienvenido(a)" Style="{StaticResource Texto.Titulo}"/>
                    <TextBlock Text="Ingrese con sus credenciales institucionales para continuar."
                               Style="{StaticResource Texto.Cuerpo}" Margin="0,7,0,0"/>

                    <!-- Selector de institución (tenant) -->
                    <TextBlock Text="Institución" Style="{StaticResource Texto.Etiqueta}" Margin="0,26,0,5"/>
                    <ComboBox Style="{StaticResource Selector}"
                              ItemsSource="{Binding Tenants}"
                              SelectedItem="{Binding Institucion}"
                              DisplayMemberPath="Nombre"
                              ToolTip="Cada institución opera con sus datos aislados"/>

                    <!-- Correo -->
                    <TextBlock Text="{Binding EmailEtiqueta}" Style="{StaticResource Texto.Etiqueta}" Margin="0,17,0,5"/>
                    <TextBox Style="{StaticResource Campo}"
                             Tag="&#xE715;"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Contraseña -->
                    <TextBlock Text="Contraseña" Style="{StaticResource Texto.Etiqueta}" Margin="0,17,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PassBox" Style="{StaticResource Campo.Contrasena}"
                                     PasswordChanged="PassBox_PasswordChanged"/>
                        <Button Grid.Column="1" Style="{StaticResource Boton.Icono}"
                                Command="{Binding AlternarContrasenaCommand}"
                                Content="&#xE7B3;" FontSize="15" VerticalAlignment="Center"
                                Margin="0,0,6,0" ToolTip="Mostrar u ocultar contraseña"/>
                    </Grid>

                    <!-- Error -->
                    <Border CornerRadius="9" Padding="12,10" Margin="0,15,0,0"
                            Background="{StaticResource DangerSoftBrush}"
                            BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                            Visibility="{Binding Error, Converter={StaticResource CvtNuloVisible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{StaticResource DangerBrush}" Margin="0,1,9,0"
                                       VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}"
                                       FontSize="12.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Acción -->
                    <Button Style="{StaticResource Boton}" Margin="0,22,0,0" Padding="16,12"
                            Command="{Binding IngresarCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ingresar a SITBIO" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Margin="9,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,26,0,0"/>

                    <!-- Accesos rápidos de demostración -->
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <TextBlock Text="Accesos de demostración por rol" Style="{StaticResource Texto.Tarjeta}"/>
                        <TextBlock Text="pruebe cada perfil RBAC" Style="{StaticResource Texto.Auxiliar}"
                                   Margin="7,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding AccesosDemo}" Margin="0,11,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccesoDemo}">
                                <Button Style="{StaticResource Boton.Contorno}" Padding="11,7" Margin="0,0,7,7"
                                        Command="{Binding DataContext.AccesoRapidoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource IconFont}"
                                                   FontSize="13" Foreground="{StaticResource PrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Rol}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Persona}" FontSize="10.5"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding PieInferior}" Style="{StaticResource Texto.Auxiliar}"
                               Margin="0,20,0,0" HorizontalAlignment="Center"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
