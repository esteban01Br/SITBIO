<UserControl x:Class="SITBIO_Desktop.Views.OrdenDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OrdenDetalleViewModel}"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:mod="clr-namespace:SITBIO_Desktop.Models"
             xmlns:ctrl="clr-namespace:SITBIO_Desktop.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DesignHeight="1250" d:DesignWidth="1240">

    <UserControl.Resources>
        <!-- Diálogo de asignación de técnico -->
        <DataTemplate DataType="{x:Type vm:FormularioAsignacionOrden}">
            <StackPanel>
                <StackPanel Margin="0,0,0,13">
                    <TextBlock Text="Técnico responsable *" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource Selector}"
                              ItemsSource="{Binding DataContext.TecnicosDisponibles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding TecnicoSeleccionado}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Iniciales}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,9,0"/>
                                    <TextBlock Text="{Binding Nombre}" FontSize="13"/>
                                    <TextBlock Text="{Binding Disponibilidad}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="9,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Fecha de asignación" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding FechaAsignacion}"/>
                </StackPanel>

                <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="9" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{StaticResource InfoBrush}" Margin="0,1,8,0"/>
                        <TextBlock Text="La asignación genera un evento en la línea de tiempo y en la bitácora de auditoría del sistema."
                                   Style="{StaticResource Texto.Auxiliar}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Confirmación de cancelación (contenido en texto plano) -->
        <DataTemplate DataType="{x:Type sys:String}">
            <TextBlock Text="{Binding}" Style="{StaticResource Texto.Cuerpo}" TextWrapping="Wrap" LineHeight="21"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,34">

                <!-- ===================== Encabezado ===================== -->
                <ctrl:PageHeader Titulo="{Binding TituloPagina}"
                                 Subtitulo="{Binding SubtituloPagina}"
                                 Icono="&#xE90F;"
                                 Contador="{Binding Orden.EstadoTexto}"
                                 NotaContador="estado actual de la orden">
                    <ctrl:PageHeader.Acciones>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Boton.Contorno}" Padding="13,9" Margin="0,0,9,0"
                                    Command="{Binding VolverCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                    <TextBlock Text="Volver a la bandeja"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Boton.Acento}" Padding="15,9"
                                    Command="{Binding RegistrarIntervencionCommand}"
                                    Visibility="{Binding PuedeIntervenir, Converter={StaticResource CvtBoolVisible}}"
                                    ToolTip="Abre la ficha técnica de intervención asociada a esta orden">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                    <TextBlock Text="Registrar intervención"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctrl:PageHeader.Acciones>
                </ctrl:PageHeader>

                <!-- Aviso de incumplimiento de SLA -->
                <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="11" Padding="15,12" Margin="0,4,0,0"
                        Visibility="{Binding Orden.SLAVencido, Converter={StaticResource CvtBoolVisible}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,2,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Plazo de respuesta comprometido vencido" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="El SLA venció el "/>
                                <Run Text="{Binding Orden.FechaLimite, Mode=OneWay, StringFormat=dd MMM yyyy · HH:mm}"/>
                                <Run Text=". Escalar la orden al coordinador biomédico y registrar la acción en la bitácora."/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===================== Contenido ===================== -->
                <Grid Margin="0,18,0,0" Visibility="{Binding Orden, Converter={StaticResource CvtNuloVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.75*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Columna izquierda -->
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">

                        <!-- Datos del radicado -->
                        <Border Style="{StaticResource Tarjeta}" Padding="20,17">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                                    <TextBlock Text="Datos del radicado" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="{Binding Nota}" Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Fila 1 -->
                                    <TextBlock Grid.Row="0" Text="CÓDIGO ÚNICO" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,16,14" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}" Text="{Binding Orden.Codigo}"/>

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="TIPO" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,0,0,14" FontSize="13" FontWeight="SemiBold"
                                               Text="{Binding Orden.TipoTexto}"
                                               Foreground="{Binding Orden.Tipo, Converter={StaticResource CvtTipoColor}}"/>

                                    <!-- Fila 2 -->
                                    <TextBlock Grid.Row="1" Text="PRIORIDAD" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,12,4"/>
                                    <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="0,0,16,14"
                                            Style="{StaticResource Chip}" BorderThickness="1"
                                            Background="{Binding Orden.Prioridad, Converter={StaticResource CvtPrioridadFondo}}"
                                            BorderBrush="{Binding Orden.Prioridad, Converter={StaticResource CvtPrioridadColor}}">
                                        <TextBlock Text="{Binding Orden.PrioridadTexto}" Style="{StaticResource Chip.Texto}"
                                                   Foreground="{Binding Orden.Prioridad, Converter={StaticResource CvtPrioridadColor}}"/>
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="SOLICITANTE" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,0,0,14" FontSize="13"
                                               Text="{Binding Orden.SolicitanteNombre}" Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <!-- Fila 3 -->
                                    <TextBlock Grid.Row="2" Text="TÉCNICO RESPONSABLE" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,12,14" FontSize="13"
                                               Text="{Binding Orden.TecnicoNombre, TargetNullValue=Sin asignar}" Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="UBICACIÓN" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,0,0,14" FontSize="13"
                                               Text="{Binding Orden.EquipoUbicacion}" Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <!-- Fila 4 -->
                                    <TextBlock Grid.Row="3" Text="FECHA DE SOLICITUD" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,16,14" FontSize="13"
                                               Text="{Binding Orden.FechaSolicitud, StringFormat=dd MMM yyyy · HH:mm}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="LÍMITE DE SLA" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,0,0,14" FontSize="13"
                                               Text="{Binding Orden.FechaLimite, StringFormat=dd MMM yyyy · HH:mm}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <!-- Fila 5 -->
                                    <TextBlock Grid.Row="4" Text="COSTO ESTIMADO" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,16,0" FontSize="13" FontWeight="SemiBold"
                                               Text="{Binding Orden.CostoEstimado, Converter={StaticResource CvtMoneda}}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="COSTO REAL" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,12,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="3" FontSize="13" FontWeight="SemiBold"
                                               Text="{Binding Orden.CostoReal, Converter={StaticResource CvtMoneda}}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,4,0,13"/>

                                <StackPanel>
                                    <TextBlock Text="Descripción de la solicitud" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Orden.Descripcion}" FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="11,9" Margin="0,12,0,0"
                                            Visibility="{Binding Orden.ReporteSala, Converter={StaticResource CvtTextoVisible}}">
                                        <StackPanel>
                                            <TextBlock Text="REPORTE DE SALA" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding Orden.ReporteSala}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Línea de tiempo -->
                        <Border Style="{StaticResource Tarjeta}" Padding="20,17" Margin="0,16,0,0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="Trazabilidad de la orden" Style="{StaticResource Texto.Tarjeta}"/>
                                        <TextBlock Text="Eventos registrados en orden cronológico inverso; la bitácora completa es inmutable"
                                                   Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border CornerRadius="8" Padding="9,5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="{StaticResource PrimarySoftBrush}">
                                        <TextBlock Text="{Binding Historial.Count}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                                    </Border>
                                </Grid>

                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Historial}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type mod:EventoOrden}">
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="1" Background="{StaticResource DividerBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="15.5,26,0,0"/>
                                                    <Border Width="30" Height="30" CornerRadius="15" VerticalAlignment="Top"
                                                            Background="{StaticResource PrimarySofterBrush}"
                                                            BorderBrush="{StaticResource PrimarySoftBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Accion}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Fecha, Converter={StaticResource CvtFechaRelativa}}"
                                                                       FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                                                       Margin="9,1,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Detalle}" FontSize="11.5" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding Usuario}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ctrl:EmptyState Icono="&#xE81D;" Titulo="Sin eventos registrados"
                                                     Mensaje="La orden aún no presenta movimientos de trazabilidad."
                                                     Visibility="{Binding Historial, Converter={StaticResource CvtColeccionVacia}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Comentarios -->
                        <Border Style="{StaticResource Tarjeta}" Padding="20,17" Margin="0,16,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <TextBlock Text="Notas de seguimiento" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Comentarios del equipo sobre la evolución del trabajo"
                                               Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                                    <TextBox Style="{StaticResource AreaTexto}" Height="72"
                                             Text="{Binding NuevoComentario, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Escriba una nota de seguimiento de la orden"/>
                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="La nota se guarda con su usuario y fecha" FontSize="10.5"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource Boton.Acento}" Padding="15,9" HorizontalAlignment="Right"
                                                Command="{Binding AgregarComentarioCommand}"
                                                Visibility="{Binding PuedeComentar, Converter={StaticResource CvtBoolVisible}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                                <TextBlock Text="Agregar nota"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Comentarios}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type mod:ComentarioOrden}">
                                                <Border CornerRadius="10" Background="{StaticResource SurfaceAltBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        Padding="13,11" Margin="0,0,0,9">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="24" Height="24" CornerRadius="12"
                                                                        Background="{StaticResource PrimarySoftBrush}">
                                                                    <TextBlock Text="&#xE902;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                               Foreground="{StaticResource PrimaryBrush}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Autor}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                <Border Style="{StaticResource Chip}" Margin="9,0,0,0"
                                                                        Background="{StaticResource PrimarySofterBrush}"
                                                                        BorderBrush="{StaticResource PrimarySoftBrush}" BorderThickness="1"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding RolAutor}" Style="{StaticResource Chip.Texto}"
                                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Fecha, Converter={StaticResource CvtFechaRelativa}}"
                                                                       FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Texto}" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ctrl:EmptyState Icono="&#xE946;" Titulo="Sin notas de seguimiento"
                                                     Mensaje="Registre aquí las observaciones del equipo sobre esta orden."
                                                     Visibility="{Binding Comentarios, Converter={StaticResource CvtColeccionVacia}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Columna derecha -->
                    <StackPanel Grid.Column="1">

                        <!-- Estado y SLA -->
                        <Border Style="{StaticResource Tarjeta}" Padding="20,17">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <TextBlock Text="Estado y respuesta SLA" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Compromiso de atención del ticket" Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                Background="{Binding Orden.Estado, Converter={StaticResource CvtOrdenFondo}}"
                                                BorderBrush="{Binding Orden.Estado, Converter={StaticResource CvtOrdenColor}}">
                                            <TextBlock Text="{Binding Orden.EstadoTexto}" Style="{StaticResource Chip.Texto}"
                                                       Foreground="{Binding Orden.Estado, Converter={StaticResource CvtOrdenColor}}"/>
                                        </Border>
                                        <Border Style="{StaticResource Chip}" BorderThickness="1" Margin="7,0,0,0"
                                                Background="{Binding Orden.Prioridad, Converter={StaticResource CvtPrioridadFondo}}"
                                                BorderBrush="{Binding Orden.Prioridad, Converter={StaticResource CvtPrioridadColor}}">
                                            <TextBlock Text="{Binding Orden.PrioridadTexto}" Style="{StaticResource Chip.Texto}"
                                                       Foreground="{Binding Orden.Prioridad, Converter={StaticResource CvtPrioridadColor}}"/>
                                        </Border>
                                    </StackPanel>

                                    <Grid>
                                        <TextBlock Text="Avance del plazo" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold"
                                                   Text="{Binding Orden.ProgresoSLA, StringFormat={}{0:0} %}"
                                                   Foreground="{Binding Orden.ProgresoSLA, Converter={StaticResource CvtCargaColor}}"/>
                                    </Grid>
                                    <ProgressBar Height="7" Margin="0,7,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding Orden.ProgresoSLA, Mode=OneWay}"
                                                 Background="{StaticResource DividerBrush}"
                                                 Foreground="{Binding Orden.ProgresoSLA, Converter={StaticResource CvtCargaColor}}"/>

                                    <Grid Margin="0,9,0,0">
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                            <Run Text="{Binding Orden.HorasRestantes, Mode=OneWay, StringFormat={}{0:N0} h}"/>
                                            <Run Text="restantes"/>
                                        </TextBlock>
                                        <TextBlock HorizontalAlignment="Right" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding Orden.SLAHoras, StringFormat={}SLA de {0} h}"/>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,15,0,14"/>

                                    <StackPanel>
                                        <Button Style="{StaticResource Boton}" Padding="14,9" Margin="0,0,0,9"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding AsignarTecnicoCommand}"
                                                Visibility="{Binding PuedeAsignar, Converter={StaticResource CvtBoolVisible}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE748;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,8,0"/>
                                                <TextBlock Text="Asignar o cambiar técnico"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource Boton.Contorno}" Padding="14,9" Margin="0,0,0,9"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding IniciarCommand}"
                                                Visibility="{Binding PuedeIniciar, Converter={StaticResource CvtBoolVisible}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,8,0"/>
                                                <TextBlock Text="Iniciar ejecución"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource Boton.Contorno}" Padding="14,9" Margin="0,0,0,9"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding VerificarCommand}"
                                                Visibility="{Binding PuedeVerificar, Converter={StaticResource CvtBoolVisible}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,8,0"/>
                                                <TextBlock Text="Enviar a verificación"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource Boton.Exito}" Padding="14,9" Margin="0,0,0,9"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding CerrarCommand}"
                                                Visibility="{Binding PuedeCerrar, Converter={StaticResource CvtBoolVisible}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,8,0"/>
                                                <TextBlock Text="Cerrar y validar la orden"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource Boton.Peligro}" Padding="14,9"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding CancelarOrdenCommand}"
                                                Visibility="{Binding PuedeCancelar, Converter={StaticResource CvtBoolVisible}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,8,0"/>
                                                <TextBlock Text="Cancelar orden"/>
                                            </StackPanel>
                                        </Button>

                                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="9" Padding="11,10"
                                                Visibility="{Binding PuedeEditar, Converter={StaticResource CvtNoBoolVisible}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                           Foreground="{StaticResource WarningBrush}" Margin="0,1,8,0"/>
                                                <TextBlock Text="Su rol tiene acceso de solo lectura sobre este flujo."
                                                           Style="{StaticResource Texto.Auxiliar}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Equipo -->
                        <Border Style="{StaticResource Tarjeta}" Padding="20,17" Margin="0,16,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,13">
                                    <TextBlock Text="Equipo intervenido" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Hoja de vida del activo biomédico" Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                                    <Button Style="{StaticResource Boton.Contorno}" Padding="13,9"
                                            Command="{Binding VerEquipoCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                            <TextBlock Text="Ver hoja de vida del equipo"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource PrimarySofterBrush}">
                                            <TextBlock Text="&#xE912;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Orden.EquipoNombre}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Equipo.CodigoInventario}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Style="{StaticResource Chip}" BorderThickness="1" HorizontalAlignment="Left"
                                            Background="{Binding Equipo.Estado, Converter={StaticResource CvtEstadoEquipoFondo}}"
                                            BorderBrush="{Binding Equipo.Estado, Converter={StaticResource CvtEstadoEquipoColor}}">
                                        <TextBlock Text="{Binding Equipo.EstadoTexto}" Style="{StaticResource Chip.Texto}"
                                                   Foreground="{Binding Equipo.Estado, Converter={StaticResource CvtEstadoEquipoColor}}"/>
                                    </Border>

                                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,13,0,12"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <TextBlock Text="Categoría" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold"
                                                       Text="{Binding Equipo.Categoria}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <TextBlock Text="Ubicación" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold"
                                                       Text="{Binding Equipo.Ubicacion}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Grid>

                                        <Grid Grid.Row="2" Margin="0,8,0,0">
                                            <TextBlock Text="Preventivo próximo" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold"
                                                       Text="{Binding Equipo.ProximoMantenimiento, StringFormat=dd MMM yyyy}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Resumen de la intervención -->
                        <Border Style="{StaticResource Tarjeta}" Padding="20,17" Margin="0,16,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,13">
                                    <TextBlock Text="Resumen" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Cifras de la orden en curso" Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,14">
                                        <TextBlock Text="EVENTOS" Style="{StaticResource Texto.Etiqueta}"/>
                                        <TextBlock Text="{Binding Historial.Count}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="COMENTARIOS" Style="{StaticResource Texto.Etiqueta}"/>
                                        <TextBlock Text="{Binding Comentarios.Count}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="COSTO REAL" Style="{StaticResource Texto.Etiqueta}"/>
                                        <TextBlock Text="{Binding Orden.CostoReal, Converter={StaticResource CvtMoneda}}"
                                                   FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="TIEMPO ACTIVO" Style="{StaticResource Texto.Etiqueta}"/>
                                        <TextBlock Text="{Binding Orden.HorasRestantes, StringFormat={}{0:N0} h}" FontSize="17"
                                                   FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ===================== Orden no encontrada ===================== -->
                <ctrl:EmptyState Icono="&#xE783;" Titulo="Orden de trabajo no encontrada"
                                 Mensaje="El identificador solicitado no existe en la institución activa o fue eliminado."
                                 TextoAccion="Volver a la bandeja" AccionCommand="{Binding VolverCommand}"
                                 Visibility="{Binding NoEncontrada, Converter={StaticResource CvtBoolVisible}}"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Diálogos ===================== -->
        <ctrl:Dialogo Visible="{Binding DialogoAbierto}"
                      Titulo="{Binding TituloDialogo}"
                      Subtitulo="{Binding SubtituloDialogo}"
                      Icono="&#xE748;" Ancho="560"
                      Contenido="{Binding ContenidoDialogo}"
                      TextoConfirmar="Confirmar" TextoCancelar="Cerrar"
                      ConfirmarCommand="{Binding GuardarCommand}"
                      CancelarCommand="{Binding CancelarCommand}"/>
    </Grid>
</UserControl>
