<UserControl x:Class="SITBIO_Desktop.Views.TecnicosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TecnicosViewModel}"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:ctrl="clr-namespace:SITBIO_Desktop.Controls"
             d:DesignHeight="1150" d:DesignWidth="1240">

    <UserControl.Resources>
        <!-- Contenido del diálogo: asignación de orden a técnico -->
        <DataTemplate DataType="{x:Type vm:FormularioAsignacion}">
            <StackPanel>
                <TextBlock Text="Orden de trabajo abierta sin técnico" Style="{StaticResource Texto.Etiqueta}"/>
                <ComboBox Style="{StaticResource Selector}"
                          ItemsSource="{Binding Ordenes}"
                          SelectedItem="{Binding OrdenSeleccionada}"
                          ToolTip="Órdenes abiertas que todavía no tienen técnico asignado">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Codigo}" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Titulo}" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Técnico responsable" Style="{StaticResource Texto.Etiqueta}" Margin="0,12,0,5"/>
                <ComboBox Style="{StaticResource Selector}"
                          ItemsSource="{Binding Tecnicos}"
                          SelectedItem="{Binding TecnicoSeleccionado}"
                          ToolTip="Plantilla técnica de la institución activa">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Iniciales}" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Nombre}"/>
                                <TextBlock Text="{Binding Disponibilidad}" FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="9,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="La orden pasará al estado &quot;Asignada&quot; y quedará registrada en su trazabilidad y en la bitácora de auditoría."
                           Style="{StaticResource Texto.Auxiliar}" Margin="0,10,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,34">

                <!-- ===================== Encabezado ===================== -->
                <ctrl:PageHeader Titulo="Técnicos de mantenimiento"
                                 Subtitulo="Plantilla del área biomédica: especialidades, disponibilidad y carga semanal"
                                 Icono="&#xE716;"
                                 Contador="{Binding Contador}"
                                 NotaContador="{Binding NotaContador}">
                    <ctrl:PageHeader.Acciones>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Boton.Acento}" Padding="15,9"
                                    Command="{Binding AsignarOrdenCommand}"
                                    Visibility="{Binding PuedeAsignar, Converter={StaticResource CvtBoolVisible}}"
                                    ToolTip="Asignar una orden abierta a un técnico">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE748;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                    <TextBlock Text="Asignar orden"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctrl:PageHeader.Acciones>
                </ctrl:PageHeader>

                <!-- ===================== Indicadores ===================== -->
                <ItemsControl ItemsSource="{Binding Kpis}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TarjetaKpi}">
                            <ctrl:KpiCard Margin="0,0,14,0"
                                          Titulo="{Binding Titulo}"
                                          Valor="{Binding Valor}"
                                          Unidad="{Binding Unidad}"
                                          Icono="{Binding Icono}"
                                          IconoColor="{Binding IconoColor}"
                                          IconoFondo="{Binding IconoFondo}"
                                          DeltaTexto="{Binding Delta}"
                                          DeltaIcono="{Binding DeltaIcono}"
                                          DeltaColor="{Binding DeltaColor}"
                                          DeltaFondo="{Binding DeltaFondo}"
                                          Leyenda="{Binding Leyenda}"
                                          Ayuda="{Binding Ayuda}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===================== Rejilla de técnicos ===================== -->
                <Grid Margin="0,18,0,0">
                    <ItemsControl ItemsSource="{Binding Tecnicos}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FichaTecnico}">
                                <Border Style="{StaticResource Tarjeta}" Padding="20,16" Margin="0,0,14,14">
                                    <StackPanel>

                                        <!-- Encabezado del técnico -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="44" Height="44" CornerRadius="22"
                                                    Background="{StaticResource PrimarySoftBrush}">
                                                <TextBlock Text="{Binding Iniciales}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Especialidades}" FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Turno}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource Chip}" BorderThickness="1"
                                                    VerticalAlignment="Top"
                                                    Background="{Binding DisponibilidadFondo, Converter={StaticResource CvtHex}}"
                                                    BorderBrush="{Binding DisponibilidadColor, Converter={StaticResource CvtHex}}">
                                                <TextBlock Text="{Binding Disponibilidad}" Style="{StaticResource Chip.Texto}"
                                                           Foreground="{Binding DisponibilidadColor, Converter={StaticResource CvtHex}}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Carga semanal -->
                                        <Grid Margin="0,14,0,0">
                                            <TextBlock Text="{Binding HorasTexto}" FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding CargaTexto}" FontSize="11.5" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{Binding Carga, Converter={StaticResource CvtCargaColor}}"/>
                                        </Grid>
                                        <ProgressBar Height="6" Margin="0,7,0,0" Minimum="0" Maximum="100"
                                                     Value="{Binding Carga, Mode=OneWay}"
                                                     Background="{StaticResource DividerBrush}"
                                                     Foreground="{Binding Carga, Converter={StaticResource CvtCargaColor}}"/>

                                        <!-- Órdenes activas -->
                                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,10"/>
                                        <TextBlock Text="Órdenes activas" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,8"/>

                                        <Grid>
                                            <ItemsControl ItemsSource="{Binding OrdenesActivas}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,9">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Codigo}" FontSize="11.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                                    <TextBlock Text="{Binding TipoTexto}" FontSize="10.5"
                                                                               Foreground="{StaticResource TextMutedBrush}"
                                                                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Titulo}" FontSize="12"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding EquipoNombre}" FontSize="10.5"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <Border Grid.Column="1" Style="{StaticResource Chip}" BorderThickness="1"
                                                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Background="{Binding Estado, Converter={StaticResource CvtOrdenFondo}}"
                                                                    BorderBrush="{Binding Estado, Converter={StaticResource CvtOrdenColor}}">
                                                                <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource Chip.Texto}"
                                                                           Foreground="{Binding Estado, Converter={StaticResource CvtOrdenColor}}"/>
                                                            </Border>

                                                            <Button Grid.Column="2" Style="{StaticResource Boton.Icono.Contorno}"
                                                                    Padding="6" FontSize="13" Margin="6,0,0,0"
                                                                    ToolTip="Abrir la orden de trabajo"
                                                                    Command="{Binding DataContext.VerOrdenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}"/>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ctrl:EmptyState Grid.Row="0"
                                                             Icono="&#xE90F;" Titulo="Sin órdenes activas"
                                                             Mensaje="Este técnico no tiene solicitudes en curso asignadas."
                                                             Visibility="{Binding OrdenesActivas, Converter={StaticResource CvtColeccionVacia}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ctrl:EmptyState Grid.Row="0"
                                     Icono="&#xE716;" Titulo="Sin técnicos registrados"
                                     Mensaje="La institución activa no tiene perfiles técnicos en plantilla."
                                     TextoAccion="Asignar orden" AccionCommand="{Binding AsignarOrdenCommand}"
                                     Visibility="{Binding Tecnicos, Converter={StaticResource CvtColeccionVacia}}"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Diálogo de asignación de orden -->
        <ctrl:Dialogo Visible="{Binding DialogoAbierto}" Titulo="Asignar orden a un técnico"
                      Subtitulo="La asignación queda registrada en la trazabilidad de la orden y en la bitácora"
                      Icono="&#xE748;" Ancho="620" Contenido="{Binding ContenidoDialogo}"
                      TextoConfirmar="Asignar orden" TextoCancelar="Cancelar"
                      ConfirmarCommand="{Binding GuardarCommand}"
                      CancelarCommand="{Binding CancelarCommand}"/>
    </Grid>
</UserControl>
