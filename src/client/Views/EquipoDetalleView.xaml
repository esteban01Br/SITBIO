<UserControl x:Class="SITBIO_Desktop.Views.EquipoDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EquipoDetalleViewModel}"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:ctrl="clr-namespace:SITBIO_Desktop.Controls"
             d:DesignHeight="1250" d:DesignWidth="1240">

    <UserControl.Resources>
        <!-- Contenido del diálogo: edición rápida de estado, ubicación y responsable -->
        <DataTemplate DataType="{x:Type vm:FormularioEdicionEquipo}">
            <StackPanel>
                <TextBlock Text="Estado operativo" Style="{StaticResource Texto.Etiqueta}"/>
                <ComboBox Style="{StaticResource Selector}"
                          ItemsSource="{Binding Estados}"
                          SelectedItem="{Binding EstadoSeleccionado}"/>

                <TextBlock Text="Ubicación física" Style="{StaticResource Texto.Etiqueta}" Margin="0,12,0,5"/>
                <TextBox Style="{StaticResource Campo}" Tag="&#xE819;"
                         ToolTip="Servicio, sala o área donde se encuentra el equipo"
                         Text="{Binding Ubicacion, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Responsable" Style="{StaticResource Texto.Etiqueta}" Margin="0,12,0,5"/>
                <TextBox Style="{StaticResource Campo}"
                         ToolTip="Área o persona responsable del equipo"
                         Text="{Binding Responsable, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="La fecha de la modificación y el usuario quedan registrados en la bitácora de auditoría."
                           Style="{StaticResource Texto.Auxiliar}" Margin="0,10,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,34">

                <!-- Estado vacío: la ficha solicitada no existe en esta institución -->
                <ctrl:EmptyState Icono="&#xE783;" Titulo="Equipo no encontrado"
                                 Mensaje="La ficha solicitada no existe o pertenece a otra institución. Verifique el código de inventario."
                                 TextoAccion="Volver al inventario" AccionCommand="{Binding VolverCommand}"
                                 Visibility="{Binding NoEncontrado, Converter={StaticResource CvtBoolVisible}}"/>

                <StackPanel Visibility="{Binding Equipo, Converter={StaticResource CvtNuloVisible}}">

                    <!-- ===================== Cabecera ===================== -->
                    <ctrl:PageHeader Titulo="{Binding Equipo.Nombre}"
                                     Subtitulo="{Binding Equipo.CodigoInventario}"
                                     Icono="&#xE912;"
                                     Contador="{Binding Contador}"
                                     NotaContador="{Binding NotaContador}">
                        <ctrl:PageHeader.Acciones>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Chip}" BorderThickness="1" Margin="0,0,14,0"
                                        Background="{Binding Equipo.Estado, Converter={StaticResource CvtEstadoEquipoFondo}}"
                                        BorderBrush="{Binding Equipo.Estado, Converter={StaticResource CvtEstadoEquipoColor}}">
                                    <TextBlock Text="{Binding Equipo.EstadoTexto}" Style="{StaticResource Chip.Texto}"
                                               Foreground="{Binding Equipo.Estado, Converter={StaticResource CvtEstadoEquipoColor}}"/>
                                </Border>
                                <Button Style="{StaticResource Boton.Contorno}" Padding="13,9" Margin="0,0,9,0"
                                        Command="{Binding VolverCommand}"
                                        ToolTip="Regresar al inventario de equipos">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                        <TextBlock Text="Volver"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Boton.Acento}" Padding="15,9"
                                        Command="{Binding EditarCommand}"
                                        Visibility="{Binding PuedeEditar, Converter={StaticResource CvtBoolVisible}}"
                                        ToolTip="Editar estado, ubicación y responsable del equipo">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                        <TextBlock Text="Editar ficha"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ctrl:PageHeader.Acciones>
                    </ctrl:PageHeader>

                    <!-- ===================== Datos generales ===================== -->
                    <Border Style="{StaticResource Tarjeta}" Margin="0,18,0,0" Padding="20,16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <TextBlock Text="Datos generales" Style="{StaticResource Texto.Tarjeta}"/>
                                <TextBlock Text="Identificación técnica del activo y su ubicación operativa"
                                           Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,14">
                                    <TextBlock Text="Nombre" Style="{StaticResource Texto.Etiqueta}"/>
                                    <TextBlock Text="{Binding Equipo.Nombre}" Style="{StaticResource Texto.Dato}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,14">
                                    <TextBlock Text="Categoría" Style="{StaticResource Texto.Etiqueta}"/>
                                    <TextBlock Text="{Binding Equipo.Categoria}" Style="{StaticResource Texto.Dato}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,16,14">
                                    <TextBlock Text="Marca" Style="{StaticResource Texto.Etiqueta}"/>
                                    <TextBlock Text="{Binding Equipo.Marca}" Style="{StaticResource Texto.Dato}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="3">
                                    <TextBlock Text="Modelo" Style="{StaticResource Texto.Etiqueta}"/>
                                    <TextBlock Text="{Binding Equipo.Modelo}" Style="{StaticResource Texto.Dato}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,14">
                                    <TextBlock Text="Número de serie" Style="{StaticResource Texto.Etiqueta}"/>
                                    <TextBlock Text="{Binding Equipo.NumeroSerie}" Style="{StaticResource Texto.Dato}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,16,14">
                                    <TextBlock Text="Fabricante" Style="{StaticResource Texto.Etiqueta}"/>
                                    <TextBlock Text="{Binding Equipo.Fabricante}" Style="{StaticResource Texto.Dato}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,16,14">
                                    <TextBlock Text="Ubicación" Style="{StaticResource Texto.Etiqueta}"/>
                                    <TextBlock Text="{Binding Equipo.Ubicacion}" Style="{StaticResource Texto.Dato}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="3">
                                    <TextBlock Text="Responsable" Style="{StaticResource Texto.Etiqueta}"/>
                                    <TextBlock Text="{Binding Equipo.Responsable}" Style="{StaticResource Texto.Dato}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Clase de riesgo" Style="{StaticResource Texto.Etiqueta}"/>
                                    <TextBlock Text="{Binding Equipo.ClaseRiesgo}" Style="{StaticResource Texto.Dato}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="Resolución aplicable" Style="{StaticResource Texto.Etiqueta}"/>
                                    <TextBlock Text="{Binding Equipo.ResolucionAplicable}" Style="{StaticResource Texto.Dato}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,16,0">
                                    <TextBlock Text="Órdenes abiertas" Style="{StaticResource Texto.Etiqueta}"/>
                                    <TextBlock Text="{Binding Equipo.OrdenesAbiertas}" Style="{StaticResource Texto.Dato}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="3">
                                    <TextBlock Text="Intervenciones acumuladas" Style="{StaticResource Texto.Etiqueta}"/>
                                    <TextBlock Text="{Binding Equipo.TotalIntervenciones}" Style="{StaticResource Texto.Dato}"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- ===================== Fechas + valor ===================== -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Hoja de vida y vida útil -->
                        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,14,0" Padding="20,16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <TextBlock Text="Fechas de mantenimiento y vida útil" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Programación preventiva, calibración y desgaste del activo"
                                               Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,12">
                                            <TextBlock Text="Fecha de instalación" Style="{StaticResource Texto.Etiqueta}"/>
                                            <TextBlock Text="{Binding Equipo.FechaInstalacion, Mode=OneWay, StringFormat=dd MMM yyyy}"
                                                       Style="{StaticResource Texto.Dato}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,12">
                                            <TextBlock Text="Último mantenimiento" Style="{StaticResource Texto.Etiqueta}"/>
                                            <TextBlock Text="{Binding Equipo.UltimoMantenimiento, Mode=OneWay, StringFormat=dd MMM yyyy}"
                                                       Style="{StaticResource Texto.Dato}"
                                                       Visibility="{Binding Equipo.UltimoMantenimiento, Converter={StaticResource CvtNuloVisible}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,12">
                                            <TextBlock Text="Próximo mantenimiento" Style="{StaticResource Texto.Etiqueta}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Equipo.ProximoMantenimiento, Mode=OneWay, StringFormat=dd MMM yyyy}"
                                                           Style="{StaticResource Texto.Dato}"
                                                           Visibility="{Binding Equipo.ProximoMantenimiento, Converter={StaticResource CvtNuloVisible}}"/>
                                                <Border CornerRadius="6" Padding="6,2" Margin="8,2,0,0"
                                                        Background="{StaticResource DangerSoftBrush}"
                                                        Visibility="{Binding Equipo.PreventivoVencido, Converter={StaticResource CvtBoolVisible}}">
                                                    <TextBlock Text="vencido" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{StaticResource DangerBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,12">
                                            <TextBlock Text="Próxima calibración" Style="{StaticResource Texto.Etiqueta}"/>
                                            <TextBlock Text="{Binding Equipo.ProximaCalibracion, Mode=OneWay, StringFormat=dd MMM yyyy}"
                                                       Style="{StaticResource Texto.Dato}"
                                                       Visibility="{Binding Equipo.ProximaCalibracion, Converter={StaticResource CvtNuloVisible}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="Última calibración" Style="{StaticResource Texto.Etiqueta}"/>
                                            <TextBlock Text="{Binding Equipo.UltimaCalibracion, Mode=OneWay, StringFormat=dd MMM yyyy}"
                                                       Style="{StaticResource Texto.Dato}"
                                                       Visibility="{Binding Equipo.UltimaCalibracion, Converter={StaticResource CvtNuloVisible}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock Text="Vida útil programada" Style="{StaticResource Texto.Etiqueta}"/>
                                            <TextBlock Text="{Binding Equipo.VidaUtilMeses, Mode=OneWay, StringFormat={}{0} meses}"
                                                       Style="{StaticResource Texto.Dato}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,10,0,14"/>
                                    <ProgressBar Height="8" Minimum="0" Maximum="100"
                                                 Value="{Binding PorcentajeVida, Mode=OneWay}"
                                                 Background="{StaticResource DividerBrush}"
                                                 Foreground="{Binding PorcentajeVida, Converter={StaticResource CvtCargaColor}}"/>
                                    <Grid Margin="0,9,0,0">
                                        <TextBlock Text="{Binding VidaTranscurrida}" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding VidaUtilTexto}" FontSize="11.5" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Valor de adquisición -->
                        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="20,16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <TextBlock Text="Valor de adquisición" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Costo registrado del activo biomédico"
                                               Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding ValorAdquisicionTexto}" Style="{StaticResource Texto.Numero}"/>
                                    <Border CornerRadius="8" Padding="10,7" Margin="0,14,0,0"
                                            Background="{StaticResource PrimarySofterBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,1,7,0"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource PrimaryDarkBrush}">
                                                <Run Text="Vida útil consumida:"/>
                                                <Run Text="{Binding PorcentajeVidaTexto, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="El valor se usa para la depreciación y los informes de disponibilidad exportables."
                                               Style="{StaticResource Texto.Auxiliar}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ===================== Campos dinámicos + gráfica ===================== -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Campos personalizados del tenant -->
                        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,14,0" Padding="20,16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <TextBlock Text="Campos personalizados de la institución" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Definidos por el administrador del tenant (OBJ-06)"
                                               Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Equipo.CamposDinamicos}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="9" Padding="12,10" Margin="0,0,10,10"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Key}" Margin="0"
                                                                   Style="{StaticResource Texto.Etiqueta}"/>
                                                        <TextBlock Text="{Binding Value}" Margin="0,3,0,0"
                                                                   Style="{StaticResource Texto.Dato}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Este equipo no tiene campos personalizados registrados."
                                               Style="{StaticResource Texto.Auxiliar}"
                                               Visibility="{Binding Equipo.CamposDinamicos, Converter={StaticResource CvtColeccionVacia}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Distribución de órdenes por tipo -->
                        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="20,18">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Intervenciones por tipo" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Distribución de las órdenes de este equipo"
                                               Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ctrl:GraficaDona ItemsSource="{Binding DistribucionTipos}"
                                                  Tamanio="168" MostrarLeyenda="True"
                                                  TextoCentro="{Binding TotalOrdenes}"
                                                  SubtextoCentro="órdenes"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ===================== Órdenes del equipo ===================== -->
                    <Border Style="{StaticResource Tarjeta}" Margin="0,18,0,0" Padding="20,16,20,10">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Órdenes de trabajo del equipo" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Trazabilidad completa con código único de seguimiento"
                                               Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="7"
                                        Padding="9,5" Background="{StaticResource AccentSoftBrush}">
                                    <TextBlock Text="{Binding NotaOrdenes}" FontSize="11"
                                               Foreground="{StaticResource AccentDarkBrush}"/>
                                </Border>
                            </Grid>

                            <Grid>
                                <DataGrid ItemsSource="{Binding Ordenes}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="150" Header="CÓDIGO">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Codigo}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Binding="{Binding Titulo}" Header="TÍTULO" Width="2*"/>

                                        <DataGridTemplateColumn Width="130" Header="TIPO">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TipoTexto}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{Binding Tipo, Converter={StaticResource CvtTipoColor}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="140" Header="ESTADO">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                            Background="{Binding Estado, Converter={StaticResource CvtOrdenFondo}}"
                                                            BorderBrush="{Binding Estado, Converter={StaticResource CvtOrdenColor}}">
                                                        <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource Chip.Texto}"
                                                                   Foreground="{Binding Estado, Converter={StaticResource CvtOrdenColor}}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Boton.Icono.Contorno}" Padding="6" FontSize="13"
                                                            ToolTip="Abrir la orden de trabajo"
                                                            Command="{Binding DataContext.VerOrdenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}"/>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <ctrl:EmptyState Grid.Row="0"
                                                 Icono="&#xE90F;" Titulo="Sin órdenes registradas"
                                                 Mensaje="Este equipo aún no tiene órdenes de trabajo asociadas en la institución."
                                                 Visibility="{Binding Ordenes, Converter={StaticResource CvtColeccionVacia}}"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Diálogo de edición de la ficha -->
        <ctrl:Dialogo Visible="{Binding DialogoAbierto}" Titulo="Editar ficha del equipo"
                      Subtitulo="Los cambios quedan registrados en la bitácora de auditoría"
                      Icono="&#xE70F;" Ancho="520" Contenido="{Binding ContenidoDialogo}"
                      TextoConfirmar="Guardar cambios" TextoCancelar="Cancelar"
                      ConfirmarCommand="{Binding GuardarCommand}"
                      CancelarCommand="{Binding CancelarCommand}"/>
    </Grid>
</UserControl>
