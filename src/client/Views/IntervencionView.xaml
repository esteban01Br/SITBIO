<UserControl x:Class="SITBIO_Desktop.Views.IntervencionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:IntervencionViewModel}"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:mod="clr-namespace:SITBIO_Desktop.Models"
             xmlns:ctrl="clr-namespace:SITBIO_Desktop.Controls"
             d:DesignHeight="1200" d:DesignWidth="1240">

    <UserControl.Resources>
        <!-- Alineación derecha para columnas numéricas de las tablas -->
        <Style x:Key="TextoColumnaDerecha" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- Diálogo de repuesto consumido -->
        <DataTemplate DataType="{x:Type vm:FormularioRepuesto}">
            <StackPanel>
                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Código" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource Campo}" Tag="&#xE8A7;"
                                 Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Código interno del repuesto (opcional)"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Repuesto *" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource Campo}"
                                 Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nombre o descripción del repuesto"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Cantidad *" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource Campo}" Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Precio unitario" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource Campo}" Text="{Binding PrecioUnitario, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,34">

                <!-- ===================== Encabezado ===================== -->
                <ctrl:PageHeader Titulo="Intervención técnica"
                                 Subtitulo="{Binding NotaTecnica}"
                                 Icono="&#xE77F;"
                                 Contador="{Binding EstadoTexto}"
                                 NotaContador="estado del registro de campo">
                    <ctrl:PageHeader.Acciones>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Boton.Contorno}" Padding="13,9" Margin="0,0,9,0"
                                    Command="{Binding VolverCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                    <TextBlock Text="Volver a la orden"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Boton.Acento}" Padding="15,9"
                                    Command="{Binding GuardarCommand}"
                                    Visibility="{Binding PuedeEditar, Converter={StaticResource CvtBoolVisible}}"
                                    ToolTip="Guarda el avance de la intervención y lo registra en la bitácora">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                    <TextBlock Text="Guardar registro"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctrl:PageHeader.Acciones>
                </ctrl:PageHeader>

                <!-- ===================== Sin orden ===================== -->
                <ctrl:EmptyState Icono="&#xE783;" Titulo="Orden no encontrada"
                                 Mensaje="La orden solicitada no existe en la institución activa (aislamiento multi-tenant)."
                                 TextoAccion="Volver" AccionCommand="{Binding VolverCommand}"
                                 Visibility="{Binding OrdenNoEncontrada, Converter={StaticResource CvtBoolVisible}}"/>

                <!-- ===================== Ficha ===================== -->
                <Grid Margin="0,18,0,0" Visibility="{Binding Orden, Converter={StaticResource CvtNuloVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.75*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Columna izquierda -->
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">

                        <!-- Aviso de ficha no abierta -->
                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="11" Padding="15,13"
                                Visibility="{Binding NoRegistrada, Converter={StaticResource CvtBoolVisible}}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="{StaticResource WarningBrush}" Margin="0,2,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Aún no existe la ficha de intervención" FontSize="12.5"
                                                   FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                                        <TextBlock Text="Abra la ficha para registrar el diagnóstico, las pruebas y los repuestos en campo."
                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Style="{StaticResource Boton.Acento}" Padding="13,8" HorizontalAlignment="Right"
                                        Command="{Binding CrearCommand}"
                                        Visibility="{Binding PuedeEditar, Converter={StaticResource CvtBoolVisible}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                        <TextBlock Text="Abrir ficha"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Registro técnico -->
                        <Border Style="{StaticResource Tarjeta}" Padding="20,17" Margin="0,16,0,0"
                                Visibility="{Binding Intervencion, Converter={StaticResource CvtNuloVisible}}">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Registro técnico en campo" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="El técnico enriquece la ficha de forma progresiva durante la intervención (OBJ-05)"
                                               Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel IsEnabled="{Binding PuedeEditar}">
                                    <StackPanel Margin="0,0,0,13">
                                        <TextBlock Text="Diagnóstico técnico *" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                                        <TextBox Style="{StaticResource AreaTexto}" Height="74"
                                                 Text="{Binding Intervencion.Diagnostico, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Síntoma detectado y condiciones del equipo"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Causa raíz" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource AreaTexto}" Height="74"
                                                     Text="{Binding Intervencion.CausaRaiz, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Acciones realizadas" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource AreaTexto}" Height="74"
                                                     Text="{Binding Intervencion.AccionesRealizadas, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Pruebas ejecutadas" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource AreaTexto}" Height="74"
                                                     Text="{Binding Intervencion.PruebasRealizadas, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Resultado de pruebas" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource AreaTexto}" Height="74"
                                                     Text="{Binding Intervencion.ResultadoPrueba, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Notas de campo" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource AreaTexto}" Height="74"
                                                     Text="{Binding Intervencion.NotasCampo, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Recomendaciones" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource AreaTexto}" Height="74"
                                                     Text="{Binding Intervencion.Recomendaciones, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Repuestos -->
                        <Border Style="{StaticResource Tarjeta}" Padding="20,16,20,10" Margin="0,16,0,0"
                                Visibility="{Binding Intervencion, Converter={StaticResource CvtNuloVisible}}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Repuestos consumidos" Style="{StaticResource Texto.Tarjeta}"/>
                                        <TextBlock Text="Materiales utilizados en la intervención y su costo directo"
                                                   Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource Boton.Contorno}" Padding="12,8" HorizontalAlignment="Right"
                                            Command="{Binding NuevoRepuestoCommand}"
                                            Visibility="{Binding PuedeEditar, Converter={StaticResource CvtBoolVisible}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                            <TextBlock Text="Agregar repuesto"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid>
                                    <DataGrid ItemsSource="{Binding Repuestos}" MaxHeight="300"
                                              Style="{StaticResource Tabla}" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="CÓDIGO" Width="110" Binding="{Binding Codigo}"/>
                                            <DataGridTextColumn Header="REPUESTO" Width="*" Binding="{Binding Nombre}"/>
                                            <DataGridTextColumn Header="CANT." Width="70" Binding="{Binding Cantidad}" ElementStyle="{StaticResource TextoColumnaDerecha}"/>
                                            <DataGridTextColumn Header="V. UNITARIO" Width="120" Binding="{Binding PrecioUnitario, StringFormat={}{0:C0}}" ElementStyle="{StaticResource TextoColumnaDerecha}"/>
                                            <DataGridTextColumn Header="SUBTOTAL" Width="120" Binding="{Binding Subtotal, StringFormat={}{0:C0}}" ElementStyle="{StaticResource TextoColumnaDerecha}"/>
                                            <DataGridTemplateColumn Width="56">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Boton.Icono.Contorno}" Padding="6" FontSize="13"
                                                                Content="&#xE74D;" ToolTip="Retirar repuesto"
                                                                Command="{Binding DataContext.EliminarRepuestoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <ctrl:EmptyState Grid.Row="0" Icono="&#xE8A7;"
                                                     Titulo="Sin repuestos registrados"
                                                     Mensaje="Agregue los materiales utilizados durante la intervención."
                                                     Visibility="{Binding Repuestos, Converter={StaticResource CvtColeccionVacia}}"/>
                                </Grid>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,4">
                                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,11"/>
                                    <Grid>
                                        <TextBlock Text="Costo de repuestos" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"
                                                   Text="{Binding SubtotalRepuestos, Converter={StaticResource CvtMoneda}}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Columna derecha -->
                    <StackPanel Grid.Column="1">

                        <!-- Estado y avance -->
                        <Border Style="{StaticResource Tarjeta}" Padding="20,17"
                                Visibility="{Binding Intervencion, Converter={StaticResource CvtNuloVisible}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <TextBlock Text="Estado y avance" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Evolución del registro de campo" Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel Margin="0,0,0,13">
                                        <TextBlock Text="Estado de la intervención" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                                        <ComboBox Style="{StaticResource Selector}"
                                                  ItemsSource="{Binding Estados}"
                                                  SelectedItem="{Binding EstadoSeleccionado}"
                                                  DisplayMemberPath="Nombre"
                                                  IsEnabled="{Binding PuedeEditar}"/>
                                    </StackPanel>

                                    <Grid>
                                        <TextBlock Text="Campos diligenciados" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold"
                                                   Text="{Binding Avance, StringFormat={}{0:0} %}"
                                                   Foreground="{Binding Avance, Converter={StaticResource CvtCargaColor}}"/>
                                    </Grid>
                                    <ProgressBar Height="7" Margin="0,7,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding Avance, Mode=OneWay}"
                                                 Background="{StaticResource DividerBrush}"
                                                 Foreground="{Binding Avance, Converter={StaticResource CvtCargaColor}}"/>

                                    <Grid Margin="0,15,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Fecha de inicio" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                                            <DatePicker SelectedDate="{Binding Intervencion.FechaInicio}" IsEnabled="{Binding PuedeEditar}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Fecha de cierre" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                                            <DatePicker SelectedDate="{Binding Intervencion.FechaFin}" IsEnabled="{Binding PuedeEditar}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="9" Padding="12,11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE81D;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       Foreground="{StaticResource AccentDarkBrush}" Margin="0,1,9,0"/>
                                            <TextBlock FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{StaticResource AccentDarkBrush}">
                                                <Run Text="Al finalizar, la orden pasa automáticamente a verificación y queda firmada en la bitácora."/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Costos y tiempos -->
                        <Border Style="{StaticResource Tarjeta}" Padding="20,17" Margin="0,16,0,0"
                                Visibility="{Binding Intervencion, Converter={StaticResource CvtNuloVisible}}">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Costos y tiempos" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Inversión acumulada de la intervención" Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel IsEnabled="{Binding PuedeEditar}">
                                    <StackPanel Margin="0,0,0,13">
                                        <TextBlock Text="Horas invertidas" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                                        <TextBox Style="{StaticResource Campo}" Tag="&#xE823;"
                                                 Text="{Binding Horas, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock Text="Mano de obra" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                                        <TextBox Style="{StaticResource Campo}" Tag="&#xE90F;"
                                                 Text="{Binding ManoObra, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,13"/>

                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Repuestos" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold"
                                               Text="{Binding SubtotalRepuestos, Converter={StaticResource CvtMoneda}}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Mano de obra" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold"
                                               Text="{Binding ManoObra, Converter={StaticResource CvtMoneda}}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>

                                <Border Background="{StaticResource PrimarySofterBrush}" CornerRadius="10" Padding="13,12">
                                    <Grid>
                                        <TextBlock Text="Costo total" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="Bold"
                                                   Text="{Binding Total, Converter={StaticResource CvtMoneda}}"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Orden asociada -->
                        <Border Style="{StaticResource Tarjeta}" Padding="20,17" Margin="0,16,0,0"
                                Visibility="{Binding Intervencion, Converter={StaticResource CvtNuloVisible}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,13">
                                    <TextBlock Text="Orden asociada" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Código único de seguimiento" Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button DockPanel.Dock="Bottom" Style="{StaticResource Boton.Contorno}" Padding="13,9" Margin="0,14,0,0"
                                        Command="{Binding VerOrdenCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                        <TextBlock Text="Abrir la orden de trabajo"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel>
                                    <TextBlock Text="{Binding Orden.Codigo}" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding Orden.Titulo}" FontSize="12.5" TextWrapping="Wrap" Margin="0,5,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Orden.EquipoNombre}" FontSize="11.5" Margin="0,6,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Orden.EquipoUbicacion}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Diálogo ===================== -->
        <ctrl:Dialogo Visible="{Binding DialogoAbierto}"
                      Titulo="{Binding TituloDialogo}"
                      Subtitulo="{Binding SubtituloDialogo}"
                      Icono="&#xE8A7;" Ancho="560"
                      Contenido="{Binding ContenidoDialogo}"
                      TextoConfirmar="Agregar" TextoCancelar="Cancelar"
                      ConfirmarCommand="{Binding ConfirmarDialogoCommand}"
                      CancelarCommand="{Binding CancelarDialogoCommand}"/>
    </Grid>
</UserControl>
