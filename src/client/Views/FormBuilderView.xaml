<UserControl x:Class="SITBIO_Desktop.Views.FormBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FormBuilderViewModel}"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:mod="clr-namespace:SITBIO_Desktop.Models"
             xmlns:ctrl="clr-namespace:SITBIO_Desktop.Controls"
             d:DesignHeight="1000" d:DesignWidth="1240">

    <UserControl.Resources>
        <!-- Contenido del diálogo de alta de campo -->
        <DataTemplate DataType="{x:Type vm:CampoAlta}">
            <StackPanel>
                <TextBlock Text="Etiqueta del campo" Style="{StaticResource Texto.Etiqueta}"/>
                <TextBox Style="{StaticResource Campo}" Tag="&#xE729;"
                         Text="{Binding Etiqueta, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Texto que verá el usuario al diligenciar el formulario"/>

                <TextBlock Text="Tipo de campo" Style="{StaticResource Texto.Etiqueta}" Margin="0,14,0,5"/>
                <ComboBox Style="{StaticResource Selector}"
                          ItemsSource="{Binding Tipos}"
                          SelectedItem="{Binding TipoSeleccionado, Mode=TwoWay}"
                          ToolTip="Define el control con que se renderiza en la vista previa"/>

                <CheckBox Style="{StaticResource Casilla}" Margin="0,15,0,0"
                          Content="Campo obligatorio (el usuario no puede guardarlo vacío)"
                          IsChecked="{Binding Requerido, Mode=TwoWay}"/>

                <TextBlock Text="Ayuda / texto guía (opcional)" Style="{StaticResource Texto.Etiqueta}" Margin="0,14,0,5"/>
                <TextBox Style="{StaticResource AreaTexto}" Height="70" Tag="&#xE946;"
                         Text="{Binding Ayuda, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Se muestra debajo del campo en el formulario final"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,34">

                <!-- ===================== Encabezado ===================== -->
                <ctrl:PageHeader Titulo="{Binding TituloFormulario}"
                                 Subtitulo="{Binding SubtituloFormulario}"
                                 Icono="&#xE729;"
                                 Contador="{Binding Contador}"
                                 NotaContador="{Binding NotaContador}">
                    <ctrl:PageHeader.Acciones>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Boton.Contorno}" Padding="14,9" Margin="0,0,9,0"
                                    Command="{Binding VolverCommand}"
                                    ToolTip="Regresa al catálogo de formularios sin guardar">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Margin="0,1,7,0"/>
                                    <TextBlock Text="Volver"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Boton}" Padding="16,9"
                                    Command="{Binding GuardarFormularioCommand}"
                                    IsEnabled="{Binding PuedeEditarFormularios}"
                                    ToolTip="Guarda la estructura del formulario y lo registra en la bitácora">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Margin="0,1,7,0"/>
                                    <TextBlock Text="Guardar formulario"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctrl:PageHeader.Acciones>
                </ctrl:PageHeader>

                <!-- ===================== Constructor / vista previa ===================== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ========== Columna izquierda: campos ========== -->
                    <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,14,0" Padding="20,16">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Campos del formulario" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Defina etiqueta, tipo, obligatoriedad y orden de cada campo"
                                               Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource Boton.Contorno}" Padding="11,7"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Command="{Binding AgregarCampoCommand}"
                                        IsEnabled="{Binding PuedeEditarFormularios}"
                                        ToolTip="Agrega un nuevo campo al formulario">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Margin="0,1,6,0"/>
                                        <TextBlock Text="Agregar campo"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <TextBlock Text="Nombre del formulario" Style="{StaticResource Texto.Etiqueta}"/>
                                <TextBox Style="{StaticResource Campo}" Tag="&#xE729;"
                                         Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Nombre visible del formulario (ej. Checklist de mantenimiento preventivo)"/>
                            </StackPanel>

                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Campos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type mod:CampoDinamico}">
                                            <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,9"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="30" Height="30" CornerRadius="9"
                                                            Background="{StaticResource SurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding IconoTipo}"
                                                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Etiqueta}" FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                            <ComboBox Style="{StaticResource Selector}"
                                                                      Width="146" Padding="10,7" FontSize="12"
                                                                      ItemsSource="{Binding DataContext.TiposCampo, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      DisplayMemberPath="Nombre"
                                                                      SelectedValuePath="Valor"
                                                                      SelectedValue="{Binding Tipo, Mode=TwoWay}"
                                                                      ToolTip="Tipo de campo"
                                                                      SelectionChanged="TipoCampo_SelectionChanged"/>
                                                            <CheckBox Style="{StaticResource Casilla}"
                                                                      Margin="12,0,0,0" VerticalAlignment="Center"
                                                                      Content="Requerido"
                                                                      IsChecked="{Binding Requerido, Mode=TwoWay}"
                                                                      Checked="RequeridoCampo_Cambiado"
                                                                      Unchecked="RequeridoCampo_Cambiado"
                                                                      ToolTip="El usuario deberá diligenciarlo para guardar el registro"/>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Ayuda}"
                                                                   Style="{StaticResource Texto.Auxiliar}"
                                                                   Margin="0,6,0,0"
                                                                   Visibility="{Binding Ayuda, Converter={StaticResource CvtTextoVisible}}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <Button Style="{StaticResource Boton.Icono.Contorno}"
                                                                Padding="5" Margin="0,0,5,0" ToolTip="Subir el campo en el orden"
                                                                Command="{Binding DataContext.SubirCampoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                                        </Button>
                                                        <Button Style="{StaticResource Boton.Icono.Contorno}"
                                                                Padding="5" Margin="0,0,5,0" ToolTip="Bajar el campo en el orden"
                                                                Command="{Binding DataContext.BajarCampoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                                        </Button>
                                                        <Button Style="{StaticResource Boton.Icono.Contorno}"
                                                                Padding="5" ToolTip="Eliminar el campo del formulario"
                                                                Command="{Binding DataContext.EliminarCampoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                                       Foreground="{StaticResource DangerBrush}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border CornerRadius="10" Padding="14,13"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Visibility="{Binding Campos, Converter={StaticResource CvtColeccionVacia}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{StaticResource InfoBrush}" Margin="0,1,8,0"/>
                                        <TextBlock Text="Aún no hay campos: use «Agregar campo» para construir el formulario."
                                                   Style="{StaticResource Texto.Auxiliar}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ========== Columna derecha: vista previa ========== -->
                    <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="20,16">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Vista previa" Style="{StaticResource Texto.Tarjeta}"/>
                                    <TextBlock Text="Así verá el formulario el personal clínico al aplicarlo"
                                               Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="7"
                                        Padding="9,5" Background="{StaticResource PrimarySoftBrush}">
                                    <TextBlock Text="solo lectura" FontSize="11"
                                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                                </Border>
                            </Grid>

                            <Grid>
                                <ItemsControl x:Name="VistaPrevia" ItemsSource="{Binding Campos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type mod:CampoDinamico}">
                                            <StackPanel Margin="0,0,0,16">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                    <TextBlock Text="{Binding Etiqueta}"
                                                               Style="{StaticResource Texto.Etiqueta}" Margin="0"/>
                                                    <TextBlock Text="*" FontWeight="Bold" FontSize="13" Margin="3,0,0,0"
                                                               Foreground="{StaticResource DangerBrush}"
                                                               Visibility="{Binding Requerido, Converter={StaticResource CvtBoolVisible}}"/>
                                                </StackPanel>

                                                <!-- Texto corto -->
                                                <TextBox>
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource Campo}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="IsTabStop" Value="False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="Texto">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>

                                                <!-- Texto largo -->
                                                <TextBox>
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource AreaTexto}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Height" Value="84"/>
                                                            <Setter Property="IsTabStop" Value="False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="TextoLargo">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>

                                                <!-- Número -->
                                                <TextBox PreviewTextInput="CampoNumerico_PreviewTextInput">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource Campo}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="IsTabStop" Value="False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="Numero">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>

                                                <!-- Fecha -->
                                                <DatePicker>
                                                    <DatePicker.Style>
                                                        <Style TargetType="DatePicker">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
                                                            <Setter Property="FontSize" Value="13"/>
                                                            <Setter Property="Padding" Value="10,8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="Fecha">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DatePicker.Style>
                                                </DatePicker>

                                                <!-- Sí / No -->
                                                <CheckBox Content="Sí / No" VerticalAlignment="Center">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource Casilla}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="IsTabStop" Value="False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="Booleano">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>

                                                <!-- Selección -->
                                                <ComboBox ItemsSource="{Binding Opciones}">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox" BasedOn="{StaticResource Selector}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="IsTabStop" Value="False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="Seleccion">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>

                                                <TextBlock Text="{Binding Ayuda}" Style="{StaticResource Texto.Auxiliar}"
                                                           Margin="0,6,0,0"
                                                           Visibility="{Binding Ayuda, Converter={StaticResource CvtTextoVisible}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ctrl:EmptyState Icono="&#xE729;" Titulo="Sin campos en el formulario"
                                                 Mensaje="Agregue campos desde la columna izquierda; aquí se verá cómo quedará el formulario final."
                                                 TextoAccion="Agregar campo"
                                                 AccionCommand="{Binding AgregarCampoCommand}"
                                                 Visibility="{Binding Campos, Converter={StaticResource CvtColeccionVacia}}"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Diálogo modal: alta de campo -->
        <ctrl:Dialogo Visible="{Binding DialogoAbierto}"
                      Titulo="Agregar campo"
                      Subtitulo="Defina la etiqueta, el tipo y si el campo es obligatorio."
                      Icono="&#xE710;"
                      Ancho="560"
                      Contenido="{Binding ContenidoDialogo}"
                      TextoConfirmar="Agregar campo"
                      TextoCancelar="Cancelar"
                      ConfirmarCommand="{Binding AceptarCampoCommand}"
                      CancelarCommand="{Binding CancelarCommand}"/>
    </Grid>
</UserControl>
