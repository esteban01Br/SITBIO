<UserControl x:Class="SITBIO_Desktop.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="900">

    <Grid Margin="0,4,0,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="11" Margin="0,0,13,0"
                        Background="{Binding IconoFondo, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Text="{Binding Icono, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontFamily="{StaticResource IconFont}" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{Binding IconoColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Titulo, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Subtitulo, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource Texto.Cuerpo}" Margin="0,4,0,0"
                               Visibility="{Binding Subtitulo, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource CvtTextoVisible}}"/>
                </StackPanel>
            </StackPanel>

            <!-- Contador / resultado de búsqueda -->
            <StackPanel Orientation="Horizontal" Margin="49,8,0,0"
                        Visibility="{Binding Contador, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource CvtTextoVisible}}">
                <Border CornerRadius="6" Padding="8,3" Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding Contador, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
                <TextBlock Text="{Binding NotaContador, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Acciones del módulo (botones) -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="16,0,0,0">
            <ContentPresenter Content="{Binding Acciones, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </StackPanel>
    </Grid>
</UserControl>
