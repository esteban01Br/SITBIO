<Window x:Class="SITBIO_Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RootViewModel}"
        Title="SITBIO — Gestión de Mantenimiento de Equipos Biomédicos"
        Height="880" Width="1440"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <!-- Contenido: pantalla de acceso o aplicación -->
        <ContentControl Content="{Binding Pantalla}"/>

        <!-- Capa de notificaciones flotantes -->
        <ItemsControl ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,26,26" IsHitTestVisible="False"
                      Panel.ZIndex="9999">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToastViewModel}">
                    <Border Margin="0,7,0,0" IsHitTestVisible="True"
                            CornerRadius="11" Padding="14,12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Width="330"
                            Visibility="{Binding Visible, Converter={StaticResource CvtBoolVisible}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.18" Color="#0E1B2C"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,11,0"
                                    Background="{StaticResource InfoSoftBrush}">
                                <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Foreground="{StaticResource InfoBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Mensaje}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource Boton.Icono}"
                                    Command="{Binding CerrarCommand}" Padding="4" Margin="6,0,0,0"
                                    Content="&#xE711;" FontSize="11"
                                    ToolTip="Cerrar"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
