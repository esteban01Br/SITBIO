<Application x:Class="SITBIO_Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:views="clr-namespace:SITBIO_Desktop.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <ResourceDictionary Source="Themes/Lists.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ============ Mapeo ViewModel → Vista ============ -->
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ShellViewModel}">
                <views:ShellView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:OrdenesViewModel}">
                <views:OrdenesView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:OrdenDetalleViewModel}">
                <views:OrdenDetalleView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:IntervencionViewModel}">
                <views:IntervencionView/>
            </DataTemplate>

            <!-- ============ Activos biomédicos ============ -->
            <DataTemplate DataType="{x:Type vm:EquiposViewModel}">
                <views:EquiposView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:EquipoDetalleViewModel}">
                <views:EquipoDetalleView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TecnicosViewModel}">
                <views:TecnicosView/>
            </DataTemplate>

            <!-- ============ Analítica y gestión ============ -->
            <DataTemplate DataType="{x:Type vm:ReportesViewModel}">
                <views:ReportesView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:FormulariosViewModel}">
                <views:FormulariosView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:FormBuilderViewModel}">
                <views:FormBuilderView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:UsuariosViewModel}">
                <views:UsuariosView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:UsuarioDetalleViewModel}">
                <views:UsuarioDetalleView/>
            </DataTemplate>

            <!-- ============ Sistema ============ -->
            <DataTemplate DataType="{x:Type vm:ConfiguracionViewModel}">
                <views:ConfiguracionView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AuditoriaViewModel}">
                <views:AuditoriaView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ProximamenteViewModel}">
                <views:ProximamenteView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
