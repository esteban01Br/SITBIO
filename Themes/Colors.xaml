<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         SITBIO — Paleta clínica clara con acento azul turquesa
         Inspirada en el código de color del sector salud.
         ============================================================ -->

    <!-- Azul primario (confianza / clínica) -->
    <Color x:Key="PrimaryColor">#0B6FA4</Color>
    <Color x:Key="PrimaryDarkColor">#08567F</Color>
    <Color x:Key="PrimaryDeepColor">#06425F</Color>
    <Color x:Key="PrimaryLightColor">#3E94C6</Color>
    <Color x:Key="PrimarySoftColor">#E8F2F9</Color>
    <Color x:Key="PrimarySofterColor">#F4F9FD</Color>

    <!-- Turquesa de acento (energía / vitalidad) -->
    <Color x:Key="AccentColor">#12B5A6</Color>
    <Color x:Key="AccentDarkColor">#0E9488</Color>
    <Color x:Key="AccentSoftColor">#E4FAF7</Color>

    <!-- Neutrales -->
    <Color x:Key="BackgroundColor">#F4F7FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F8FAFD</Color>
    <Color x:Key="SurfaceHoverColor">#EFF4F9</Color>
    <Color x:Key="SidebarColor">#FFFFFF</Color>
    <Color x:Key="TopBarColor">#FFFFFF</Color>

    <Color x:Key="BorderColor">#E2E9F1</Color>
    <Color x:Key="BorderStrongColor">#C7D3E0</Color>
    <Color x:Key="DividerColor">#EDF1F6</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimaryColor">#0E1B2C</Color>
    <Color x:Key="TextSecondaryColor">#4E6076</Color>
    <Color x:Key="TextMutedColor">#8496AB</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <!-- Semáforo de estado -->
    <Color x:Key="SuccessColor">#12924E</Color>
    <Color x:Key="SuccessSoftColor">#E6F6EE</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="WarningSoftColor">#FDF3E3</Color>
    <Color x:Key="DangerColor">#D13C4B</Color>
    <Color x:Key="DangerSoftColor">#FCECED</Color>
    <Color x:Key="InfoColor">#2E9BE5</Color>
    <Color x:Key="InfoSoftColor">#E7F3FD</Color>
    <Color x:Key="PurpleColor">#7A5AF8</Color>
    <Color x:Key="PurpleSoftColor">#EEEAFE</Color>

    <!-- Paleta cromática de gráficas -->
    <Color x:Key="Chart1Color">#0B6FA4</Color>
    <Color x:Key="Chart2Color">#12B5A6</Color>
    <Color x:Key="Chart3Color">#7A5AF8</Color>
    <Color x:Key="Chart4Color">#F2A33C</Color>
    <Color x:Key="Chart5Color">#3BB19A</Color>
    <Color x:Key="Chart6Color">#E5484D</Color>
    <Color x:Key="Chart7Color">#5B8DEF</Color>

    <!-- ============================ Brushes ============================ -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryDeepBrush" Color="{StaticResource PrimaryDeepColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>
    <SolidColorBrush x:Key="PrimarySofterBrush" Color="{StaticResource PrimarySofterColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="TopBarBrush" Color="{StaticResource TopBarColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="{StaticResource PurpleSoftColor}"/>

    <SolidColorBrush x:Key="Chart1Brush" Color="{StaticResource Chart1Color}"/>
    <SolidColorBrush x:Key="Chart2Brush" Color="{StaticResource Chart2Color}"/>
    <SolidColorBrush x:Key="Chart3Brush" Color="{StaticResource Chart3Color}"/>
    <SolidColorBrush x:Key="Chart4Brush" Color="{StaticResource Chart4Color}"/>
    <SolidColorBrush x:Key="Chart5Brush" Color="{StaticResource Chart5Color}"/>
    <SolidColorBrush x:Key="Chart6Brush" Color="{StaticResource Chart6Color}"/>
    <SolidColorBrush x:Key="Chart7Brush" Color="{StaticResource Chart7Color}"/>

</ResourceDictionary>
