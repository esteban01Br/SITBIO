<UserControl x:Class="SITBIO_Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:mod="clr-namespace:SITBIO_Desktop.Models"
             xmlns:ctrl="clr-namespace:SITBIO_Desktop.Controls"
             d:DesignHeight="1100" d:DesignWidth="1240">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,34">

            <!-- ===================== Encabezado ===================== -->
            <ctrl:PageHeader Titulo="{Binding Saludo}"
                             Subtitulo="{Binding Fecha}"
                             Icono=""
                             Contador="{Binding TotalOrdenes}"
                             NotaContador="{Binding TotalEtiqueta}">
                <ctrl:PageHeader.Acciones>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Boton.Contorno}" Padding="13,9" Margin="0,0,9,0"
                                Command="{Binding ExportarPdfCommand}"
                                ToolTip="Descarga un informe PDF del panel para auditoría">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource DangerBrush}" Margin="0,1,7,0"/>
                                <TextBlock Text="PDF"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Boton.Contorno}" Padding="13,9" Margin="0,0,9,0"
                                Command="{Binding ExportarExcelCommand}"
                                ToolTip="Descarga los indicadores en formato Excel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource SuccessBrush}" Margin="0,1,7,0"/>
                                <TextBlock Text="Excel"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Boton.Acento}" Padding="15,9"
                                Command="{Binding ActualizarCommand}"
                                ToolTip="Recalcula los indicadores con la información más reciente">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                <TextBlock Text="Actualizar"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ctrl:PageHeader.Acciones>
            </ctrl:PageHeader>

            <!-- ===================== Franja de resumen ===================== -->
            <Border Background="{StaticResource PrimarySofterBrush}"
                    BorderBrush="{StaticResource PrimarySoftBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16,13" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Resumen operativo del mes" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                        <TextBlock Text="{Binding ResumenOperativo}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2" CornerRadius="8" Padding="10,6" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center"
                            Visibility="{Binding AlertasActivas, Converter={StaticResource CvtCero}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{StaticResource WarningBrush}" Margin="0,1,7,0"/>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                <Run Text="{Binding AlertasActivas, Mode=OneWay}"/>
                                <Run Text="alertas activas"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===================== Indicadores ===================== -->
            <ItemsControl ItemsSource="{Binding Kpis}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TarjetaKpi}">
                        <ctrl:KpiCard Margin="0,0,14,0"
                                      Titulo="{Binding Titulo}"
                                      Valor="{Binding Valor}"
                                      Unidad="{Binding Unidad}"
                                      Icono="{Binding Icono}"
                                      IconoColor="{Binding IconoColor}"
                                      IconoFondo="{Binding IconoFondo}"
                                      DeltaTexto="{Binding Delta}"
                                      DeltaIcono="{Binding DeltaIcono}"
                                      DeltaColor="{Binding DeltaColor}"
                                      DeltaFondo="{Binding DeltaFondo}"
                                      Leyenda="{Binding Leyenda}"
                                      Ayuda="{Binding Ayuda}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===================== Gráficas ===================== -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Carga de mantenimiento -->
                <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,14,0" Padding="20,18">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Carga de mantenimiento" Style="{StaticResource Texto.Tarjeta}"/>
                                <TextBlock Text="Solicitudes atendidas en los últimos 6 meses"
                                           Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="7"
                                    Padding="9,5" Background="{StaticResource AccentSoftBrush}">
                                <TextBlock Text="preventivo + correctivo" FontSize="11"
                                           Foreground="{StaticResource AccentDarkBrush}"/>
                            </Border>
                        </Grid>

                        <StackPanel>
                            <ctrl:GraficaBarras ItemsSource="{Binding Mantenimientos}"
                                                ColorBarra="{StaticResource PrimaryBrush}"
                                                Altura="176" AnchoBarra="34"/>
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,0"/>
                            <TextBlock Text="Cada columna cuenta las órdenes registradas en el mes. Los preventivos vencidos se listan en la franja de alertas."
                                       Style="{StaticResource Texto.Auxiliar}" Margin="0,11,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Distribución por estado -->
                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="20,18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Órdenes por estado" Style="{StaticResource Texto.Tarjeta}"/>
                            <TextBlock Text="Distribución actual del flujo de trabajo"
                                       Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ctrl:GraficaDona ItemsSource="{Binding PorEstado}"
                                          TextoCentro="{Binding TotalOrdenes}"
                                          SubtextoCentro="órdenes"
                                          Tamanio="172"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===================== Prioridad + atención ===================== -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Órdenes prioritarias -->
                <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,14,0" Padding="20,16,20,8">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="Órdenes prioritarias" Style="{StaticResource Texto.Tarjeta}"/>
                                <TextBlock Text="Ordenadas por criticidad y tiempo restante de respuesta"
                                           Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource Boton.Fantasma}" Padding="8,5"
                                    HorizontalAlignment="Right" HorizontalContentAlignment="Right"
                                    Command="{Binding IrCommand}" CommandParameter="ordenes"
                                    Content="Ver todas "/>
                        </Grid>

                        <Grid>
                            <DataGrid ItemsSource="{Binding OrdenesPrioritarias}" MaxHeight="340"
                                      Style="{StaticResource Tabla}"
                                      MouseDoubleClick="Ordenes_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="128" Header="CÓDIGO">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Codigo}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrush}" FontSize="12"/>
                                                    <TextBlock Text="{Binding FechaSolicitud, StringFormat=dd MMM HH:mm}"
                                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="*" Header="EQUIPO / SOLICITUD">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding EquipoNombre, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding EquipoUbicacion, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="104" Header="PRIORIDAD">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Chip}"
                                                        Background="{Binding Prioridad, Converter={StaticResource CvtPrioridadFondo}}"
                                                        BorderBrush="{Binding Prioridad, Converter={StaticResource CvtPrioridadColor}}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding PrioridadTexto}" Style="{StaticResource Chip.Texto}"
                                                               Foreground="{Binding Prioridad, Converter={StaticResource CvtPrioridadColor}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="126" Header="ESTADO">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Chip}"
                                                        Background="{Binding Estado, Converter={StaticResource CvtOrdenFondo}}"
                                                        BorderBrush="{Binding Estado, Converter={StaticResource CvtOrdenColor}}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource Chip.Texto}"
                                                               Foreground="{Binding Estado, Converter={StaticResource CvtOrdenColor}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="150" Header="RESPUESTA SLA">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                                               Text="{Binding HorasRestantes, StringFormat={}{0:N0} h restantes}"
                                                               Foreground="{Binding ProgresoSLA, Converter={StaticResource CvtCargaColor}}"/>
                                                    <ProgressBar Height="5" Margin="0,5,0,0"
                                                                 Minimum="0" Maximum="100"
                                                                 Value="{Binding ProgresoSLA, Mode=OneWay}"
                                                                 Background="{StaticResource DividerBrush}"
                                                                 Foreground="{Binding ProgresoSLA, Converter={StaticResource CvtCargaColor}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="52">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Boton.Icono.Contorno}" Padding="6"
                                                        Content="" FontSize="13"
                                                        ToolTip="Abrir la orden de trabajo"
                                                        Command="{Binding DataContext.VerOrdenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <ctrl:EmptyState Grid.Row="0"
                                             Icono="" Titulo="Sin órdenes prioritarias"
                                             Mensaje="No hay solicitudes abiertas que requieran atención inmediata."
                                             Visibility="{Binding OrdenesPrioritarias, Converter={StaticResource CvtColeccionVacia}}"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Equipos con atención requerida -->
                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="20,16,20,16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Requieren atención" Style="{StaticResource Texto.Tarjeta}"/>
                            <TextBlock Text="Preventivos vencidos y equipos detenidos"
                                       Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding EquiposAtencion}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type mod:Equipo}">
                                    <Border CornerRadius="10" Padding="12,11" Margin="0,0,0,8"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            MouseLeftButtonUp="Equipo_MouseLeftButtonUp" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="30" Height="30" CornerRadius="9"
                                                    Background="{Binding Estado, Converter={StaticResource CvtEstadoEquipoFondo}}">
                                                <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{Binding Estado, Converter={StaticResource CvtEstadoEquipoColor}}"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Nombre}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding CodigoInventario, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Ubicacion, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Grid.Column="2" CornerRadius="6" Padding="6,3" Margin="6,0,0,0"
                                                    Background="{StaticResource DangerSoftBrush}"
                                                    Visibility="{Binding PreventivoVencido, Converter={StaticResource CvtBoolVisible}}">
                                                <TextBlock Text="vencido" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource DangerBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ctrl:EmptyState Grid.Row="0" Icono=""
                                         Titulo="Todo al día"
                                         Mensaje="Ningún equipo presenta preventivos vencidos ni detenciones."
                                         Visibility="{Binding EquiposAtencion, Converter={StaticResource CvtColeccionVacia}}"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===================== Actividad + categorías ===================== -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bitácora resumida -->
                <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,14,0" Padding="20,16,20,14">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Actividad reciente" Style="{StaticResource Texto.Tarjeta}"/>
                                <TextBlock Text="Últimos movimientos registrados en la bitácora de auditoría"
                                           Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource Boton.Fantasma}" Padding="8,5"
                                    HorizontalAlignment="Right"
                                    Command="{Binding IrCommand}" CommandParameter="auditoria"
                                    Content="Abrir bitácora "/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Actividad}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type mod:ActividadReciente}">
                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,0,0"
                                                Background="{Binding Color, Converter={StaticResource CvtHex}}" Opacity="0.16"/>
                                        <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Color, Converter={StaticResource CvtHex}}"/>

                                        <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Titulo}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Fecha, Converter={StaticResource CvtFechaRelativa}}"
                                                           FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="8,1,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Descripcion}" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Usuario}" FontSize="10.5"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Categorías -->
                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="20,16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Parque por categoría" Style="{StaticResource Texto.Tarjeta}"/>
                            <TextBlock Text="Composición de los equipos registrados"
                                       Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ctrl:GraficaDona ItemsSource="{Binding PorCategorias}"
                                          Tamanio="158" MostrarLeyenda="True"
                                          TextoCentro="Activos" SubtextoCentro="registrados"/>
                    </DockPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
