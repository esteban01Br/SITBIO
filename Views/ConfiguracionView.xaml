<UserControl x:Class="SITBIO_Desktop.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:ctrl="clr-namespace:SITBIO_Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConfiguracionViewModel}"
             d:DesignHeight="1300" d:DesignWidth="1240">

    <UserControl.Resources>
        <!-- Contenido del diálogo de alta de campo dinámico -->
        <DataTemplate DataType="{x:Type vm:FormularioCampo}">
            <StackPanel>
                <TextBlock Text="Etiqueta visible del campo" Style="{StaticResource Texto.Etiqueta}"/>
                <TextBox Style="{StaticResource Campo}" Tag="&#xE729;"
                         Text="{Binding Etiqueta, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Nombre del campo que verá el usuario al diligenciar el formulario"/>

                <TextBlock Text="Tipo de dato" Style="{StaticResource Texto.Etiqueta}" Margin="0,14,0,5"/>
                <ComboBox Style="{StaticResource Selector}"
                          ItemsSource="{Binding Tipos}"
                          SelectedItem="{Binding TipoSeleccionado}"
                          DisplayMemberPath="Nombre"/>

                <CheckBox Style="{StaticResource Casilla}" Margin="0,16,0,0"
                          IsChecked="{Binding Requerido}"
                          Content="Campo obligatorio (bloquea el envío del formulario si está vacío)"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,34">

                <!-- ===================== Encabezado ===================== -->
                <ctrl:PageHeader Titulo="Configuración"
                                 Subtitulo="Parámetros de la institución, campos dinámicos y matriz de permisos"
                                 Icono="&#xE713;"
                                 Contador="{Binding Contador}"
                                 NotaContador="{Binding NotaContador}"/>

                <!-- ===================== Pestañas ===================== -->
                <Border Style="{StaticResource Tarjeta}" Padding="18,12" Margin="0,18,0,0">
                    <TabControl Style="{StaticResource Pestanas}">

                        <!-- ============ Institución ============ -->
                        <TabItem Style="{StaticResource Pestana}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE819;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                    <TextBlock Text="Institución" Margin="8,0,0,0"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Datos del tenant -->
                                <Border Grid.Column="0" Style="{StaticResource Tarjeta.Sencilla}" Margin="0,0,14,0" Padding="18,16">
                                    <StackPanel>
                                        <TextBlock Text="Datos de la institución activa" Style="{StaticResource Texto.Tarjeta}"/>
                                        <TextBlock Text="Información registrada del tenant con el que inició la sesión"
                                                   Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,14"/>

                                        <TextBlock Text="Razón social" Style="{StaticResource Texto.Etiqueta}"/>
                                        <TextBlock Text="{Binding Institucion.Nombre}" Style="{StaticResource Texto.Dato}"/>

                                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="NIT" Style="{StaticResource Texto.Etiqueta}"/>
                                                <TextBlock Text="{Binding Institucion.NIT}" Style="{StaticResource Texto.Dato}" FontSize="13"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <TextBlock Text="Plan contratado" Style="{StaticResource Texto.Etiqueta}"/>
                                                <TextBlock Text="{Binding PlanTexto}" Style="{StaticResource Texto.Dato}" FontSize="13"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                                <TextBlock Text="Dirección" Style="{StaticResource Texto.Etiqueta}"/>
                                                <TextBlock Text="{Binding Institucion.Direccion}" Style="{StaticResource Texto.Dato}" FontSize="13"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="14,12,0,0">
                                                <TextBlock Text="Ciudad" Style="{StaticResource Texto.Etiqueta}"/>
                                                <TextBlock Text="{Binding Institucion.Ciudad}" Style="{StaticResource Texto.Dato}" FontSize="13"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                                <TextBlock Text="Teléfono" Style="{StaticResource Texto.Etiqueta}"/>
                                                <TextBlock Text="{Binding Institucion.Telefono}" Style="{StaticResource Texto.Dato}" FontSize="13"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="14,12,0,0">
                                                <TextBlock Text="Resolución sanitaria" Style="{StaticResource Texto.Etiqueta}"/>
                                                <TextBlock Text="{Binding Institucion.ResolucionSanitaria}" Style="{StaticResource Texto.Dato}" FontSize="13"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                                <TextBlock Text="Estado del tenant" Style="{StaticResource Texto.Etiqueta}"/>
                                                <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource Texto.Dato}" FontSize="13"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Aislamiento multi-tenant -->
                                <Border Grid.Column="1" Style="{StaticResource Tarjeta.Sencilla}" Padding="18,16">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="10"
                                                Background="{StaticResource PrimarySofterBrush}">
                                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Aislamiento multi-tenant (RSK-03)" Style="{StaticResource Texto.Tarjeta}" Margin="0,12,0,0"/>
                                        <TextBlock Text="Toda consulta del sistema se filtra por el identificador de la institución activa (patrón Row Level Security). Los usuarios, equipos, órdenes y bitácoras de una institución nunca son visibles desde otra."
                                                   Style="{StaticResource Texto.Cuerpo}" FontSize="12" Margin="0,8,0,0"/>
                                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,12"/>
                                        <TextBlock Text="En producción, este filtro se aplica además en la capa de datos con EF Core (tenant_id) y en las políticas de autorización del API."
                                                   Style="{StaticResource Texto.Auxiliar}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ============ Parámetros operativos ============ -->
                        <TabItem Style="{StaticResource Pestana}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                    <TextBlock Text="Parámetros operativos" Margin="8,0,0,0"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Tarjeta.Sencilla}" Margin="0,0,14,0" Padding="18,16">
                                    <StackPanel>
                                        <TextBlock Text="Parámetros por defecto del tenant" Style="{StaticResource Texto.Tarjeta}"/>
                                        <TextBlock Text="Valores que usan las órdenes, los preventivos y las calibraciones al crearse"
                                                   Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Horas de SLA por defecto" Style="{StaticResource Texto.Etiqueta}"/>
                                                <TextBox Style="{StaticResource Campo}" Tag="&#xE823;"
                                                         Text="{Binding HorasSlaPorDefecto, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Tiempo comprometido de respuesta para las órdenes (1 a 720 horas)"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Días de anticipación de preventivos" Style="{StaticResource Texto.Etiqueta}"/>
                                                <TextBox Style="{StaticResource Campo}" Tag="&#xE787;"
                                                         Text="{Binding DiasPreventivos, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Con cuántos días de antelación se programa un mantenimiento preventivo"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                                <TextBlock Text="Vigencia de calibraciones (días)" Style="{StaticResource Texto.Etiqueta}"/>
                                                <TextBox Style="{StaticResource Campo}" Tag="&#xE716;"
                                                         Text="{Binding VigenciaCalibraciones, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Vida útil de un certificado de calibración antes de vencer"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,14,0,0">
                                                <TextBlock Text="Prefijo de código de órdenes" Style="{StaticResource Texto.Etiqueta}"/>
                                                <TextBox Style="{StaticResource Campo}" Tag="&#xE90F;"
                                                         Text="{Binding PrefijoCodigo, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Formato del código único: SIT-YYYY-NNNNNN"/>
                                                <TextBlock Text="Ejemplo del siguiente código: SIT-2026-000123"
                                                           Style="{StaticResource Texto.Auxiliar}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,18,0,12"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Boton}" Padding="16,9" Tag="&#xE73E;"
                                                    Command="{Binding GuardarParametrosCommand}"
                                                    Visibility="{Binding PuedeEditarConfiguracion, Converter={StaticResource CvtBoolVisible}}"
                                                    ToolTip="Registra los parámetros en la bitácora de auditoría">
                                                <TextBlock Text="Guardar parámetros"/>
                                            </Button>
                                            <Border CornerRadius="8" Padding="11,8" Margin="12,0,0,0"
                                                    Background="{StaticResource WarningSoftBrush}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding PuedeEditarConfiguracion, Converter={StaticResource CvtNoBoolVisible}}">
                                                <TextBlock Text="Su rol solo puede consultar esta configuración"
                                                           FontSize="11.5" Foreground="{StaticResource WarningBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Nota de trazabilidad -->
                                <Border Grid.Column="1" Style="{StaticResource Tarjeta.Sencilla}" Padding="18,16">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="10"
                                                Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                       Foreground="{StaticResource AccentDarkBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Cambios auditados" Style="{StaticResource Texto.Tarjeta}" Margin="0,12,0,0"/>
                                        <TextBlock Text="Cada guardado genera un evento de tipo Actualización en la bitácora inmutable con el usuario, la fecha y los valores aplicados; así se evidencia quién autorizó cada cambio de parámetro (Resolución 3100 de 2019)."
                                                   Style="{StaticResource Texto.Cuerpo}" FontSize="12" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ============ Campos dinámicos ============ -->
                        <TabItem Style="{StaticResource Pestana}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE729;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                    <TextBlock Text="Campos dinámicos" Margin="8,0,0,0"/>
                                </StackPanel>
                            </TabItem.Header>

                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Campos dinámicos del tenant" Style="{StaticResource Texto.Tarjeta}"/>
                                        <TextBlock Text="Extensiones de los formularios sin tocar el código (OBJ-06)"
                                                   Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource Boton.Secundario}" Padding="14,8" Tag="&#xE710;"
                                            HorizontalAlignment="Right"
                                            Command="{Binding AgregarCampoCommand}"
                                            Visibility="{Binding PuedeEditarConfiguracion, Converter={StaticResource CvtBoolVisible}}"
                                            ToolTip="Agrega un campo nuevo a los formularios de esta institución">
                                        <TextBlock Text="Agregar campo"/>
                                    </Button>
                                </Grid>

                                <Grid>
                                    <DataGrid ItemsSource="{Binding CamposDinamicos}" MaxHeight="330">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="1.3*" Header="CAMPO">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Etiqueta}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Ayuda}" FontSize="10.5"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       Visibility="{Binding Ayuda, Converter={StaticResource CvtTextoVisible}}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Width="150" Header="TIPO" Binding="{Binding TipoTexto}" FontSize="12"/>

                                            <DataGridTemplateColumn Width="130" Header="OBLIGATORIO">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                                    Background="{StaticResource PrimarySoftBrush}"
                                                                    BorderBrush="{StaticResource PrimaryBrush}"
                                                                    Visibility="{Binding Requerido, Converter={StaticResource CvtBoolVisible}}">
                                                                <TextBlock Text="Obligatorio" Style="{StaticResource Chip.Texto}"
                                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                                    Background="{StaticResource SurfaceAltBrush}"
                                                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                                                    Visibility="{Binding Requerido, Converter={StaticResource CvtNoBoolVisible}}">
                                                                <TextBlock Text="Opcional" Style="{StaticResource Chip.Texto}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Boton.Icono.Contorno}" Padding="6" Content="&#xE74D;" FontSize="13"
                                                                ToolTip="Eliminar el campo del tenant"
                                                                Command="{Binding DataContext.EliminarCampoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding DataContext.PuedeEditarConfiguracion, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource CvtBoolVisible}}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <ctrl:EmptyState Icono="&#xE729;"
                                                     Titulo="Sin campos dinámicos"
                                                     Mensaje="Esta institución aún no define campos personalizados para sus formularios."
                                                     TextoAccion="Agregar campo"
                                                     AccionCommand="{Binding AgregarCampoCommand}"
                                                     Visibility="{Binding CamposDinamicos, Converter={StaticResource CvtColeccionVacia}}"/>
                                </Grid>

                                <Border Background="{StaticResource PrimarySofterBrush}"
                                        BorderBrush="{StaticResource PrimarySoftBrush}" BorderThickness="1"
                                        CornerRadius="9" Padding="13,11" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,1,8,0"/>
                                        <TextBlock Style="{StaticResource Texto.Auxiliar}" MaxWidth="980"
                                                   TextWrapping="Wrap"
                                                   Text="Los campos dinámicos permiten que cada institución adapte los formularios de inspección y recepción a su normativa interna, sin requerir una nueva versión del software (OBJ-06). Se guardan en memoria en esta fase y sobreviven a la navegación de la sesión."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ============ Permisos ============ -->
                        <TabItem Style="{StaticResource Pestana}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                    <TextBlock Text="Permisos" Margin="8,0,0,0"/>
                                </StackPanel>
                            </TabItem.Header>

                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Matriz de permisos por rol" Style="{StaticResource Texto.Tarjeta}"/>
                                        <TextBlock Text="Nivel de acceso de cada rol sobre cada área del sistema (RBAC DOC-01-FCP §6.1)"
                                                   Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Leyenda}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LeyendaPermiso}">
                                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                                    <Border Width="9" Height="9" CornerRadius="5" Margin="0,0,7,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding Nivel, Converter={StaticResource CvtNivelColor}}"/>
                                                    <TextBlock Text="{Binding Nivel, Converter={StaticResource CvtNivelTexto}}"
                                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding Nivel, Converter={StaticResource CvtNivelColor}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <DataGrid ItemsSource="{Binding Permisos}" MaxHeight="440">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="1.2*" Header="ÁREA">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding AreaTexto}" FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Descripcion}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="146" Header="ADMINISTRADOR">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                                        <Border Width="9" Height="9" CornerRadius="5" Margin="0,0,7,0" VerticalAlignment="Center"
                                                                Background="{Binding Administrador, Converter={StaticResource CvtNivelColor}}"/>
                                                        <TextBlock Text="{Binding Administrador, Converter={StaticResource CvtNivelTexto}}"
                                                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{Binding Administrador, Converter={StaticResource CvtNivelColor}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="146" Header="COORDINADOR">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                                        <Border Width="9" Height="9" CornerRadius="5" Margin="0,0,7,0" VerticalAlignment="Center"
                                                                Background="{Binding Coordinador, Converter={StaticResource CvtNivelColor}}"/>
                                                        <TextBlock Text="{Binding Coordinador, Converter={StaticResource CvtNivelTexto}}"
                                                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{Binding Coordinador, Converter={StaticResource CvtNivelColor}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="146" Header="TÉCNICO">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                                        <Border Width="9" Height="9" CornerRadius="5" Margin="0,0,7,0" VerticalAlignment="Center"
                                                                Background="{Binding Tecnico, Converter={StaticResource CvtNivelColor}}"/>
                                                        <TextBlock Text="{Binding Tecnico, Converter={StaticResource CvtNivelTexto}}"
                                                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{Binding Tecnico, Converter={StaticResource CvtNivelColor}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="146" Header="PERSONAL CLÍNICO">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                                        <Border Width="9" Height="9" CornerRadius="5" Margin="0,0,7,0" VerticalAlignment="Center"
                                                                Background="{Binding PersonalClinico, Converter={StaticResource CvtNivelColor}}"/>
                                                        <TextBlock Text="{Binding PersonalClinico, Converter={StaticResource CvtNivelTexto}}"
                                                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{Binding PersonalClinico, Converter={StaticResource CvtNivelColor}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="146" Header="DIRECTOR">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                                        <Border Width="9" Height="9" CornerRadius="5" Margin="0,0,7,0" VerticalAlignment="Center"
                                                                Background="{Binding Director, Converter={StaticResource CvtNivelColor}}"/>
                                                        <TextBlock Text="{Binding Director, Converter={StaticResource CvtNivelTexto}}"
                                                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{Binding Director, Converter={StaticResource CvtNivelColor}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="146" Header="REGULADOR">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                                        <Border Width="9" Height="9" CornerRadius="5" Margin="0,0,7,0" VerticalAlignment="Center"
                                                                Background="{Binding Regulador, Converter={StaticResource CvtNivelColor}}"/>
                                                        <TextBlock Text="{Binding Regulador, Converter={StaticResource CvtNivelTexto}}"
                                                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{Binding Regulador, Converter={StaticResource CvtNivelColor}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="9" Padding="13,11" Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource Texto.Auxiliar}" TextWrapping="Wrap"
                                               Text="La matriz se deriva de la matriz de actores del DOC-01-FCP §6.1 y se consulta desde el núcleo PermisosRbac, por lo que la UI y las operaciones usan el mismo criterio (OBJ-02). Solo el Administrador de Sistema tiene nivel Total sobre todas las áreas."/>
                                </Border>
                            </StackPanel>
                        </TabItem>

                    </TabControl>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Diálogo de campo dinámico ===================== -->
        <ctrl:Dialogo Visible="{Binding DialogoAbierto}"
                      Titulo="Nuevo campo dinámico"
                      Subtitulo="El campo quedará disponible en los formularios de la institución"
                      Icono="&#xE710;" Ancho="560"
                      Contenido="{Binding ContenidoDialogo}"
                      TextoConfirmar="Agregar"
                      TextoCancelar="Cancelar"
                      ConfirmarCommand="{Binding GuardarCampoCommand}"
                      CancelarCommand="{Binding CancelarCampoCommand}"/>
    </Grid>
</UserControl>
