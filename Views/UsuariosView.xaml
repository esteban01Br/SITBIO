<UserControl x:Class="SITBIO_Desktop.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:ctrl="clr-namespace:SITBIO_Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UsuariosViewModel}"
             d:DesignHeight="1250" d:DesignWidth="1240">

    <UserControl.Resources>

        <!-- Chip de rol: color según la sigla del rol -->
        <Style x:Key="ChipRolFondo" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SiglaRol}" Value="CBM">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SiglaRol}" Value="TEC">
                    <Setter Property="Background" Value="{StaticResource PurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SiglaRol}" Value="PCL">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SiglaRol}" Value="DIR">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SiglaRol}" Value="REG">
                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChipRolTexto" TargetType="TextBlock" BasedOn="{StaticResource Chip.Texto}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SiglaRol}" Value="CBM">
                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SiglaRol}" Value="TEC">
                    <Setter Property="Foreground" Value="{StaticResource PurpleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SiglaRol}" Value="PCL">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SiglaRol}" Value="DIR">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SiglaRol}" Value="REG">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Formulario de alta de usuario (contenido del diálogo modal) -->
        <DataTemplate DataType="{x:Type vm:FormularioUsuario}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Nombres" Style="{StaticResource Texto.Etiqueta}"/>
                        <TextBox Style="{StaticResource Campo}" Tag="&#xE77B;"
                                 Text="{Binding Nombres, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nombres de la persona"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Apellidos" Style="{StaticResource Texto.Etiqueta}"/>
                        <TextBox Style="{StaticResource Campo}" Tag="&#xE77B;"
                                 Text="{Binding Apellidos, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Apellidos de la persona"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Correo institucional" Style="{StaticResource Texto.Etiqueta}"/>
                        <TextBox Style="{StaticResource Campo}" Tag="&#xE716;"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Ejemplo: nombre@institucion.com"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Cargo" Style="{StaticResource Texto.Etiqueta}"/>
                        <TextBox Style="{StaticResource Campo}" Tag="&#xE81D;"
                                 Text="{Binding Cargo, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Rol funcional de la persona en la institución"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Rol en la matriz RBAC" Style="{StaticResource Texto.Etiqueta}" Margin="0,14,0,5"/>
                <ComboBox Style="{StaticResource Selector}"
                          ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding RolSeleccionado}"
                          DisplayMemberPath="Nombre"
                          ToolTip="Define el nivel de acceso de la cuenta sobre cada área"/>

                <Border Background="{StaticResource InfoSoftBrush}"
                        BorderBrush="{StaticResource InfoBrush}" BorderThickness="1"
                        CornerRadius="9" Padding="12,10" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource InfoBrush}" Margin="0,1,8,0"/>
                        <TextBlock Style="{StaticResource Texto.Auxiliar}" MaxWidth="440" TextWrapping="Wrap"
                                   Text="La cuenta se crea activa con clave provisional y queda registrada en la bitácora. La autenticación definitiva usará BCrypt + JWT (OBJ-02)."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,34">

                <!-- ===================== Encabezado ===================== -->
                <ctrl:PageHeader Titulo="Usuarios"
                                 Subtitulo="Padrón de cuentas, roles y estados de acceso de la institución"
                                 Icono="&#xE902;"
                                 Contador="{Binding Contador}"
                                 NotaContador="{Binding NotaContador}">
                    <ctrl:PageHeader.Acciones>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Boton.Acento}" Padding="15,9"
                                    Command="{Binding NuevoCommand}"
                                    ToolTip="Da de alta una cuenta nueva en esta institución"
                                    Visibility="{Binding PuedeEditarUsuarios, Converter={StaticResource CvtBoolVisible}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                    <TextBlock Text="Nuevo usuario"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctrl:PageHeader.Acciones>
                </ctrl:PageHeader>

                <!-- ===================== Indicadores ===================== -->
                <ItemsControl ItemsSource="{Binding Kpis}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TarjetaKpi}">
                            <ctrl:KpiCard Margin="0,0,14,0"
                                          Titulo="{Binding Titulo}"
                                          Valor="{Binding Valor}"
                                          Unidad="{Binding Unidad}"
                                          Icono="{Binding Icono}"
                                          IconoColor="{Binding IconoColor}"
                                          IconoFondo="{Binding IconoFondo}"
                                          DeltaTexto="{Binding Delta}"
                                          DeltaIcono="{Binding DeltaIcono}"
                                          DeltaColor="{Binding DeltaColor}"
                                          DeltaFondo="{Binding DeltaFondo}"
                                          Leyenda="{Binding Leyenda}"
                                          Ayuda="{Binding Ayuda}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===================== Filtros ===================== -->
                <Border Style="{StaticResource Tarjeta}" Padding="16,14" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Style="{StaticResource Campo}" Tag="&#xE721;"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Buscar por nombre, correo o cargo"/>

                        <ComboBox Grid.Column="1" Style="{StaticResource Selector}" Margin="10,0"
                                  ItemsSource="{Binding RolesFiltro}"
                                  SelectedItem="{Binding RolFiltro}"
                                  ToolTip="Filtra el padrón por rol"/>

                        <ComboBox Grid.Column="2" Style="{StaticResource Selector}" Margin="0,0,10,0"
                                  ItemsSource="{Binding EstadosFiltro}"
                                  SelectedItem="{Binding EstadoFiltro}"
                                  ToolTip="Filtra por estado de la cuenta"/>

                        <Button Grid.Column="3" Style="{StaticResource Boton.Contorno}"
                                Command="{Binding LimpiarFiltrosCommand}" Content="Limpiar"/>
                    </Grid>
                </Border>

                <!-- ===================== Padrón de usuarios ===================== -->
                <Border Style="{StaticResource Tarjeta}" Padding="18,14" Margin="0,16,0,0">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Usuarios}" MaxHeight="520"
                                  MouseDoubleClick="Usuarios_MouseDoubleClick">
                            <DataGrid.Columns>

                                <DataGridTemplateColumn Width="*" MinWidth="230" Header="USUARIO">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                                <Border Width="32" Height="32" CornerRadius="16"
                                                        Background="{StaticResource PrimarySoftBrush}" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Iniciales}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryDarkBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding NombreCompleto}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Width="210" Header="CORREO" Binding="{Binding Email}" FontSize="11.5"/>

                                <DataGridTextColumn Width="160" Header="CARGO" Binding="{Binding Cargo}" FontSize="11.5"/>

                                <DataGridTemplateColumn Width="216" Header="ROL">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                                <Border Style="{StaticResource ChipRolFondo}">
                                                    <TextBlock Text="{Binding SiglaRol}" Style="{StaticResource ChipRolTexto}"/>
                                                </Border>
                                                <TextBlock Text="{Binding NombreRol}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="132"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="106" Header="ESTADO">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                        Background="{StaticResource SuccessSoftBrush}"
                                                        BorderBrush="{StaticResource SuccessBrush}"
                                                        Visibility="{Binding Activo, Converter={StaticResource CvtBoolVisible}}">
                                                    <TextBlock Text="Activo" Style="{StaticResource Chip.Texto}"
                                                               Foreground="{StaticResource SuccessBrush}"/>
                                                </Border>
                                                <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                        Background="{StaticResource DangerSoftBrush}"
                                                        BorderBrush="{StaticResource DangerBrush}"
                                                        Visibility="{Binding Activo, Converter={StaticResource CvtNoBoolVisible}}">
                                                    <TextBlock Text="Inactivo" Style="{StaticResource Chip.Texto}"
                                                               Foreground="{StaticResource DangerBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="132" Header="ÚLTIMO ACCESO">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="{Binding UltimoAcceso, Converter={StaticResource CvtFechaRelativa}}"/>
                                                <TextBlock Text="aún no inicia sesión" FontSize="10.5"
                                                           Foreground="{StaticResource TextMutedBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UltimoAcceso}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="118">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource Boton.Icono.Contorno}" Padding="6" FontSize="13"
                                                        ToolTip="Abrir la ficha del usuario"
                                                        Command="{Binding DataContext.VerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                                </Button>

                                                <Button Style="{StaticResource Boton.Icono.Contorno}" Padding="6" FontSize="13"
                                                        Margin="7,0,0,0"
                                                        ToolTip="Activa o desactiva la cuenta de la institución"
                                                        Command="{Binding DataContext.AlternarActivoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.PuedeEditarUsuarios, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource CvtBoolVisible}}">
                                                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE711;"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                        <Setter Property="Text" Value="&#xE73E;"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <ctrl:EmptyState Icono="&#xE902;"
                                         Titulo="Sin usuarios que mostrar"
                                         Mensaje="Ninguna cuenta coincide con los filtros aplicados, o la institución aún no tiene usuarios registrados."
                                         TextoAccion="Nuevo usuario"
                                         AccionCommand="{Binding NuevoCommand}"
                                         Visibility="{Binding Usuarios, Converter={StaticResource CvtColeccionVacia}}"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Diálogo de alta de usuario ===================== -->
        <ctrl:Dialogo Visible="{Binding DialogoAbierto}"
                      Titulo="Nuevo usuario"
                      Subtitulo="Alta de una cuenta en la institución activa"
                      Icono="&#xE710;" Ancho="620"
                      Contenido="{Binding ContenidoDialogo}"
                      TextoConfirmar="Guardar"
                      TextoCancelar="Cancelar"
                      ConfirmarCommand="{Binding GuardarCommand}"
                      CancelarCommand="{Binding CancelarCommand}"/>
    </Grid>
</UserControl>
