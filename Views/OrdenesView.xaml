<UserControl x:Class="SITBIO_Desktop.Views.OrdenesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OrdenesViewModel}"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:mod="clr-namespace:SITBIO_Desktop.Models"
             xmlns:ctrl="clr-namespace:SITBIO_Desktop.Controls"
             d:DesignHeight="1150" d:DesignWidth="1240">

    <UserControl.Resources>
        <!-- Formulario de alta de orden: contenido del diálogo modal -->
        <DataTemplate DataType="{x:Type vm:FormularioOrden}">
            <StackPanel>
                <StackPanel Margin="0,0,0,13">
                    <TextBlock Text="Equipo biomédico *" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource Selector}"
                              ItemsSource="{Binding Equipos}"
                              SelectedItem="{Binding EquipoSeleccionado}"
                              ToolTip="Seleccione el activo sobre el cual se ejecutará la orden"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,13">
                    <TextBlock Text="Título de la solicitud *" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource Campo}" Tag="&#xE90F;"
                             Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Resumen breve de la falla o del trabajo solicitado"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,13">
                    <TextBlock Text="Descripción / reporte de sala" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource AreaTexto}" Height="86"
                             Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Detalle del síntoma, del lugar y de las condiciones de operación"/>
                </StackPanel>

                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tipo de mantenimiento *" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource Selector}"
                                  ItemsSource="{Binding Tipos}"
                                  SelectedItem="{Binding TipoSeleccionado}"
                                  DisplayMemberPath="Nombre"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Prioridad de respuesta *" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource Selector}"
                                  ItemsSource="{Binding Prioridades}"
                                  SelectedItem="{Binding PrioridadSeleccionada}"
                                  DisplayMemberPath="Nombre"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Plazo comprometido (SLA)" Style="{StaticResource Texto.Etiqueta}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource Selector}"
                                  ItemsSource="{Binding Plazos}"
                                  SelectedItem="{Binding SlaHoras}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,1,7,0"/>
                            <TextBlock Text="El código único de seguimiento se genera al guardar"
                                       Style="{StaticResource Texto.Auxiliar}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,34">

                <!-- ===================== Encabezado ===================== -->
                <ctrl:PageHeader Titulo="Órdenes de trabajo"
                                 Subtitulo="Bandeja de solicitudes y tablero Kanban con trazabilidad por código único"
                                 Icono="&#xE90F;"
                                 Contador="{Binding Contador}"
                                 NotaContador="{Binding NotaContador}">
                    <ctrl:PageHeader.Acciones>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Boton.Contorno}" Padding="13,9" Margin="0,0,9,0"
                                    Command="{Binding ExportarPdfCommand}"
                                    Visibility="{Binding PuedeExportar, Converter={StaticResource CvtBoolVisible}}"
                                    ToolTip="Descarga en PDF de las órdenes filtradas para auditoría">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource DangerBrush}" Margin="0,1,7,0"/>
                                    <TextBlock Text="PDF"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Boton.Contorno}" Padding="13,9" Margin="0,0,9,0"
                                    Command="{Binding ExportarExcelCommand}"
                                    Visibility="{Binding PuedeExportar, Converter={StaticResource CvtBoolVisible}}"
                                    ToolTip="Descarga en Excel de las órdenes filtradas">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource SuccessBrush}" Margin="0,1,7,0"/>
                                    <TextBlock Text="Excel"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Boton.Acento}" Padding="15,9"
                                    Command="{Binding NuevoCommand}"
                                    Visibility="{Binding PuedeCrearOrden, Converter={StaticResource CvtBoolVisible}}"
                                    ToolTip="Registra una nueva solicitud con código de seguimiento">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                    <TextBlock Text="Nueva orden"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctrl:PageHeader.Acciones>
                </ctrl:PageHeader>

                <!-- ===================== Indicadores ===================== -->
                <ItemsControl ItemsSource="{Binding Kpis}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TarjetaKpi}">
                            <ctrl:KpiCard Margin="0,0,14,0"
                                          Titulo="{Binding Titulo}"
                                          Valor="{Binding Valor}"
                                          Unidad="{Binding Unidad}"
                                          Icono="{Binding Icono}"
                                          IconoColor="{Binding IconoColor}"
                                          IconoFondo="{Binding IconoFondo}"
                                          DeltaTexto="{Binding Delta}"
                                          DeltaIcono="{Binding DeltaIcono}"
                                          DeltaColor="{Binding DeltaColor}"
                                          DeltaFondo="{Binding DeltaFondo}"
                                          Leyenda="{Binding Leyenda}"
                                          Ayuda="{Binding Ayuda}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===================== Filtros ===================== -->
                <Border Style="{StaticResource Tarjeta}" Padding="16,14" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Style="{StaticResource Campo}" Tag="&#xE721;"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Buscar por código, título, equipo, ubicación o técnico"/>

                        <ComboBox Grid.Column="1" Style="{StaticResource Selector}" Margin="10,0"
                                  ItemsSource="{Binding EstadosFiltro}"
                                  SelectedItem="{Binding EstadoFiltro}"
                                  ToolTip="Filtrar por estado del flujo"/>

                        <ComboBox Grid.Column="2" Style="{StaticResource Selector}" Margin="10,0"
                                  ItemsSource="{Binding PrioridadesFiltro}"
                                  SelectedItem="{Binding PrioridadFiltro}"
                                  ToolTip="Filtrar por prioridad de respuesta"/>

                        <ComboBox Grid.Column="3" Style="{StaticResource Selector}" Margin="10,0"
                                  ItemsSource="{Binding TiposFiltro}"
                                  SelectedItem="{Binding TipoFiltro}"
                                  ToolTip="Filtrar por tipo de mantenimiento"/>

                        <Button Grid.Column="4" Style="{StaticResource Boton.Contorno}" Padding="13,9" Margin="0,0,10,0"
                                Command="{Binding LimpiarFiltrosCommand}" Content="Limpiar"/>

                        <Button Grid.Column="5" Style="{StaticResource Boton.Contorno}" Padding="13,9"
                                Command="{Binding AlternarVistaCommand}"
                                ToolTip="Alterna entre la vista de tabla y el tablero Kanban">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IconoVista}" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Margin="0,1,7,0"/>
                                <TextBlock Text="{Binding TextoVista}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ===================== Vista de tabla ===================== -->
                <Border Style="{StaticResource Tarjeta}" Padding="20,16,20,8" Margin="0,16,0,0"
                        Visibility="{Binding VistaEsKanban, Converter={StaticResource CvtNoBoolVisible}}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Bandeja de órdenes" Style="{StaticResource Texto.Tarjeta}"/>
                                <TextBlock Text="Ordenadas por estado abierto, criticidad y fecha de solicitud"
                                           Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource Boton.Fantasma}" Padding="8,5" HorizontalAlignment="Right"
                                    Command="{Binding ActualizarCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,6,0"/>
                                    <TextBlock Text="Actualizar"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid>
                            <DataGrid ItemsSource="{Binding Ordenes}" MaxHeight="620"
                                      Style="{StaticResource Tabla}"
                                      MouseDoubleClick="Orden_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="132" Header="CÓDIGO">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Codigo}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrush}" FontSize="12"/>
                                                    <TextBlock Text="{Binding FechaSolicitud, StringFormat=dd MMM HH:mm}"
                                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="*" Header="SOLICITUD / EQUIPO">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding EquipoNombre, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding EquipoUbicacion, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="112" Header="TIPO">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TipoTexto}" FontSize="11.5"
                                                           Foreground="{Binding Tipo, Converter={StaticResource CvtTipoColor}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="104" Header="PRIORIDAD">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                        Background="{Binding Prioridad, Converter={StaticResource CvtPrioridadFondo}}"
                                                        BorderBrush="{Binding Prioridad, Converter={StaticResource CvtPrioridadColor}}">
                                                    <TextBlock Text="{Binding PrioridadTexto}" Style="{StaticResource Chip.Texto}"
                                                               Foreground="{Binding Prioridad, Converter={StaticResource CvtPrioridadColor}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="128" Header="ESTADO">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                        Background="{Binding Estado, Converter={StaticResource CvtOrdenFondo}}"
                                                        BorderBrush="{Binding Estado, Converter={StaticResource CvtOrdenColor}}">
                                                    <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource Chip.Texto}"
                                                               Foreground="{Binding Estado, Converter={StaticResource CvtOrdenColor}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="140" Header="TÉCNICO">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TecnicoNombre}" FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TecnicoNombre}" Value="">
                                                                    <Setter Property="Text" Value="Sin asignar"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="146" Header="RESPUESTA SLA">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                                               Text="{Binding HorasRestantes, StringFormat={}{0:N0} h restantes}"
                                                               Foreground="{Binding ProgresoSLA, Converter={StaticResource CvtCargaColor}}"/>
                                                    <ProgressBar Height="5" Margin="0,5,0,0" Minimum="0" Maximum="100"
                                                                 Value="{Binding ProgresoSLA, Mode=OneWay}"
                                                                 Background="{StaticResource DividerBrush}"
                                                                 Foreground="{Binding ProgresoSLA, Converter={StaticResource CvtCargaColor}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="58">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Boton.Icono.Contorno}" Padding="6" FontSize="13"
                                                        Content="&#xE8A7;" ToolTip="Abrir la orden"
                                                        Command="{Binding DataContext.VerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <ctrl:EmptyState Grid.Row="0" Icono="&#xE721;"
                                             Titulo="Ninguna orden coincide con los filtros"
                                             Mensaje="Ajuste la búsqueda o limpie los filtros para ver toda la bandeja del tenant."
                                             TextoAccion="Limpiar filtros"
                                             AccionCommand="{Binding LimpiarFiltrosCommand}"
                                             Visibility="{Binding Ordenes, Converter={StaticResource CvtColeccionVacia}}"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- ===================== Tablero Kanban ===================== -->
                <ItemsControl ItemsSource="{Binding Columnas}" Margin="0,16,0,0"
                              Visibility="{Binding VistaEsKanban, Converter={StaticResource CvtBoolVisible}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ColumnaKanbanVista}">
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="12,13" Margin="0,0,12,0" MinHeight="300">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="30" Height="30" CornerRadius="9"
                                                Background="{Binding Color, Converter={StaticResource CvtHex}}">
                                            <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Titulo}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Descripcion}" FontSize="10.5"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="9" Padding="8,4" VerticalAlignment="Center"
                                                Background="{Binding Color, Converter={StaticResource CvtHex}}">
                                            <TextBlock Text="{Binding Contador}" FontSize="11" FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Ordenes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type mod:OrdenTrabajo}">
                                                    <Border CornerRadius="10" Padding="11,10" Margin="0,0,0,9"
                                                            Background="{StaticResource SurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            Cursor="Hand" MouseLeftButtonUp="Orden_MouseLeftButtonUp">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Codigo}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                                                <Border Grid.Column="1" Style="{StaticResource Chip}" BorderThickness="1"
                                                                        Background="{Binding Prioridad, Converter={StaticResource CvtPrioridadFondo}}"
                                                                        BorderBrush="{Binding Prioridad, Converter={StaticResource CvtPrioridadColor}}">
                                                                    <TextBlock Text="{Binding PrioridadTexto}" Style="{StaticResource Chip.Texto}"
                                                                               Foreground="{Binding Prioridad, Converter={StaticResource CvtPrioridadColor}}"/>
                                                                </Border>
                                                            </Grid>

                                                            <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold"
                                                                       Margin="0,7,0,0" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                                                            <TextBlock FontSize="10.5" Margin="0,4,0,0"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding EquipoNombre, Mode=OneWay}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding EquipoUbicacion, Mode=OneWay}"/>
                                                            </TextBlock>

                                                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,9,0,8"/>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel>
                                                                    <TextBlock FontSize="10.5" FontWeight="SemiBold"
                                                                               Text="{Binding HorasRestantes, StringFormat={}{0:N0} h de SLA}"
                                                                               Foreground="{Binding ProgresoSLA, Converter={StaticResource CvtCargaColor}}"/>
                                                                    <TextBlock FontSize="10" Margin="0,2,0,0"
                                                                               Foreground="{StaticResource TextMutedBrush}"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding TecnicoNombre, Mode=OneWay}"/>
                                                                        <Run Text=" · "/>
                                                                        <Run Text="{Binding TipoTexto, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <Button Grid.Column="1" Style="{StaticResource Boton.Icono.Contorno}"
                                                                        Padding="6" FontSize="12" Content="&#xE76A;"
                                                                        ToolTip="Avanzar al siguiente estado"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding DataContext.PuedeCrearOrden, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource CvtBoolVisible}}"
                                                                        Command="{Binding DataContext.AvanzarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Sin órdenes en esta columna" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" Margin="0,14,0,6"
                                                   Visibility="{Binding Ordenes, Converter={StaticResource CvtColeccionVacia}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Diálogo de nueva orden ===================== -->
        <ctrl:Dialogo Visible="{Binding DialogoAbierto}"
                      Titulo="Nueva orden de trabajo"
                      Subtitulo="Se asignará automáticamente el código único de seguimiento del tenant"
                      Icono="&#xE710;" Ancho="620"
                      Contenido="{Binding ContenidoDialogo}"
                      TextoConfirmar="Crear orden" TextoCancelar="Cancelar"
                      ConfirmarCommand="{Binding GuardarCommand}"
                      CancelarCommand="{Binding CancelarCommand}"/>
    </Grid>
</UserControl>