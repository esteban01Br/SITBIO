<UserControl x:Class="SITBIO_Desktop.Views.AuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:mod="clr-namespace:SITBIO_Desktop.Models"
             xmlns:ctrl="clr-namespace:SITBIO_Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AuditoriaViewModel}"
             d:DesignHeight="1300" d:DesignWidth="1240">

    <UserControl.Resources>

        <!-- Chip de acción: color según el tipo de evento de la bitácora -->
        <Style x:Key="ChipAccionFondo" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Accion}" Value="Creacion">
                    <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="Actualizacion">
                    <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="Eliminacion">
                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="Asignacion">
                    <Setter Property="Background" Value="{StaticResource PurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="CambioEstado">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="Validacion">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="Exportacion">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChipAccionTexto" TargetType="TextBlock" BasedOn="{StaticResource Chip.Texto}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Accion}" Value="Creacion">
                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="Actualizacion">
                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="Eliminacion">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="Asignacion">
                    <Setter Property="Foreground" Value="{StaticResource PurpleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="CambioEstado">
                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="Validacion">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="Exportacion">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,34">

                <!-- ===================== Encabezado ===================== -->
                <ctrl:PageHeader Titulo="Auditoría"
                                 Subtitulo="Bitácora inmutable de eventos de la institución activa"
                                 Icono="&#xE81C;"
                                 Contador="{Binding Contador}"
                                 NotaContador="{Binding NotaContador}">
                    <ctrl:PageHeader.Acciones>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Boton.Contorno}" Padding="15,9"
                                    Command="{Binding ExportarCommand}"
                                    ToolTip="Descarga el informe de indicadores como evidencia para la auditoría">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource AccentBrush}" Margin="0,1,7,0"/>
                                    <TextBlock Text="Exportar evidencia"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctrl:PageHeader.Acciones>
                </ctrl:PageHeader>

                <!-- ===================== Aviso de inmutabilidad ===================== -->
                <Border Background="{StaticResource WarningSoftBrush}"
                        BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16,13" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource WarningBrush}">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Bitácora inmutable (RSK-01)" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="Este registro solo admite altas: la interfaz no ofrece edición ni borrado de eventos, de modo que la trazabilidad de quién hizo qué y cuándo se conserva íntegra para las auditorías del INVIMA y de la Secretaría de Salud (Resolución 3100 de 2019)."
                                       FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===================== Indicadores ===================== -->
                <ItemsControl ItemsSource="{Binding Kpis}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TarjetaKpi}">
                            <ctrl:KpiCard Margin="0,0,14,0"
                                          Titulo="{Binding Titulo}"
                                          Valor="{Binding Valor}"
                                          Unidad="{Binding Unidad}"
                                          Icono="{Binding Icono}"
                                          IconoColor="{Binding IconoColor}"
                                          IconoFondo="{Binding IconoFondo}"
                                          DeltaTexto="{Binding Delta}"
                                          DeltaIcono="{Binding DeltaIcono}"
                                          DeltaColor="{Binding DeltaColor}"
                                          DeltaFondo="{Binding DeltaFondo}"
                                          Leyenda="{Binding Leyenda}"
                                          Ayuda="{Binding Ayuda}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===================== Filtros ===================== -->
                <Border Style="{StaticResource Tarjeta}" Padding="16,14" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Style="{StaticResource Campo}" Tag="&#xE721;"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Buscar por usuario, entidad, referencia o detalle del evento"/>

                        <ComboBox Grid.Column="1" Style="{StaticResource Selector}" Margin="10,0"
                                  ItemsSource="{Binding AccionesFiltro}"
                                  SelectedItem="{Binding AccionFiltro}"
                                  ToolTip="Filtra por el tipo de acción registrada"/>

                        <ComboBox Grid.Column="2" Style="{StaticResource Selector}" Margin="0,0,10,0"
                                  ItemsSource="{Binding RangosFiltro}"
                                  SelectedItem="{Binding RangoFiltro}"
                                  ToolTip="Filtra por el rango de fechas del evento"/>

                        <Button Grid.Column="3" Style="{StaticResource Boton.Contorno}"
                                Command="{Binding LimpiarFiltrosCommand}" Content="Limpiar"/>
                    </Grid>
                </Border>

                <!-- ===================== Bitácora ===================== -->
                <Border Style="{StaticResource Tarjeta}" Padding="18,14" Margin="0,16,0,0">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Eventos}" MaxHeight="520">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="152" Header="FECHA"
                                                    Binding="{Binding Fecha, StringFormat=dd MMM yyyy · HH:mm}"
                                                    FontSize="11.5"/>

                                <DataGridTextColumn Width="164" Header="USUARIO" Binding="{Binding Usuario}" FontSize="11.5"/>

                                <DataGridTemplateColumn Width="62" Header="ROL">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                                    Padding="8,3">
                                                <TextBlock Text="{Binding Rol}" Style="{StaticResource Chip.Texto}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="156" Header="ACCIÓN">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ChipAccionFondo}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource IconFont}"
                                                               FontSize="11" Margin="0,0,6,0"
                                                               Style="{StaticResource ChipAccionTexto}"/>
                                                    <TextBlock Text="{Binding AccionTexto}" Style="{StaticResource ChipAccionTexto}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Width="126" Header="ENTIDAD" Binding="{Binding Entidad}" FontSize="11.5"/>

                                <DataGridTextColumn Width="150" Header="REFERENCIA" Binding="{Binding Referencia}" FontSize="11.5"/>

                                <DataGridTextColumn Width="*" Header="DETALLE" Binding="{Binding Detalle}" FontSize="11.5"/>

                                <DataGridTextColumn Width="150" Header="DISPOSITIVO" Binding="{Binding Dispositivo}" FontSize="11"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ctrl:EmptyState Icono="&#xE81C;"
                                         Titulo="Sin eventos que mostrar"
                                         Mensaje="Ningún evento de la bitácora coincide con los filtros aplicados."
                                         TextoAccion="Limpiar filtros"
                                         AccionCommand="{Binding LimpiarFiltrosCommand}"
                                         Visibility="{Binding Eventos, Converter={StaticResource CvtColeccionVacia}}"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
