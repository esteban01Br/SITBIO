<UserControl x:Class="SITBIO_Desktop.Views.EquiposView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EquiposViewModel}"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:ctrl="clr-namespace:SITBIO_Desktop.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DesignHeight="1150" d:DesignWidth="1240">

    <UserControl.Resources>
        <!-- Contenido del diálogo: formulario de alta de equipo -->
        <DataTemplate DataType="{x:Type vm:FormularioEquipo}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Identificación del equipo" Style="{StaticResource Texto.Etiqueta}"/>

                <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource Campo}" Tag="&#xE8A7;"
                         Margin="0,0,10,10" ToolTip="Código de inventario único (ej. BM-0231)"
                         Text="{Binding CodigoInventario, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Campo}" Margin="0,0,0,10"
                         ToolTip="Nombre o descripción técnica del equipo"
                         Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Grid.Row="2" Grid.Column="0" Style="{StaticResource Campo}" Tag="&#xE721;"
                         Margin="0,0,10,10" ToolTip="Categoría del equipo (ej. Bomba de infusión)"
                         Text="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Campo}" Margin="0,0,0,10"
                         ToolTip="Marca del fabricante"
                         Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Grid.Row="3" Grid.Column="0" Style="{StaticResource Campo}" Margin="0,0,10,10"
                         ToolTip="Modelo del equipo"
                         Text="{Binding Modelo, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Campo}" Margin="0,0,0,10"
                         ToolTip="Número de serie del fabricante"
                         Text="{Binding NumeroSerie, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Grid.Row="4" Grid.Column="0" Style="{StaticResource Campo}" Tag="&#xE819;"
                         Margin="0,0,10,10" ToolTip="Ubicación física dentro de la institución"
                         Text="{Binding Ubicacion, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Campo}" Margin="0,0,0,10"
                         ToolTip="Área o persona responsable del equipo"
                         Text="{Binding Responsable, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,5"
                           Text="Estado operativo inicial" Style="{StaticResource Texto.Etiqueta}"/>

                <ComboBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                          Style="{StaticResource Selector}"
                          ItemsSource="{Binding Estados}"
                          SelectedItem="{Binding EstadoSeleccionado}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                           Style="{StaticResource Texto.Auxiliar}"
                           Text="La fecha de instalación y los campos personalizados se completan en la hoja de vida del equipo."/>
            </Grid>
        </DataTemplate>

        <!-- Contenido del diálogo de confirmación: mensaje de baja -->
        <DataTemplate DataType="{x:Type sys:String}">
            <TextBlock Text="{Binding}" Style="{StaticResource Texto.Cuerpo}"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,34">

                <!-- ===================== Encabezado ===================== -->
                <ctrl:PageHeader Titulo="Equipos biomédicos"
                                 Subtitulo="Parque de activos de la institución activa: hoja de vida, estado operativo y trazabilidad"
                                 Icono="&#xE912;"
                                 Contador="{Binding Contador}"
                                 NotaContador="{Binding NotaContador}">
                    <ctrl:PageHeader.Acciones>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Boton.Contorno}" Padding="13,9" Margin="0,0,9,0"
                                    Command="{Binding ExportarExcelCommand}"
                                    ToolTip="Descarga el inventario biomédico en formato Excel">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource SuccessBrush}" Margin="0,1,7,0"/>
                                    <TextBlock Text="Excel"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Boton.Acento}" Padding="15,9"
                                    Command="{Binding NuevoCommand}"
                                    Visibility="{Binding PuedeEditar, Converter={StaticResource CvtBoolVisible}}"
                                    ToolTip="Registra un nuevo activo en el inventario">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                                    <TextBlock Text="Nuevo equipo"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ctrl:PageHeader.Acciones>
                </ctrl:PageHeader>

                <!-- ===================== Indicadores ===================== -->
                <ItemsControl ItemsSource="{Binding Kpis}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TarjetaKpi}">
                            <ctrl:KpiCard Margin="0,0,14,0"
                                          Titulo="{Binding Titulo}"
                                          Valor="{Binding Valor}"
                                          Unidad="{Binding Unidad}"
                                          Icono="{Binding Icono}"
                                          IconoColor="{Binding IconoColor}"
                                          IconoFondo="{Binding IconoFondo}"
                                          DeltaTexto="{Binding Delta}"
                                          DeltaIcono="{Binding DeltaIcono}"
                                          DeltaColor="{Binding DeltaColor}"
                                          DeltaFondo="{Binding DeltaFondo}"
                                          Leyenda="{Binding Leyenda}"
                                          Ayuda="{Binding Ayuda}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===================== Filtros ===================== -->
                <Border Style="{StaticResource Tarjeta}" Padding="16,14" Margin="0,18,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Campo}" Tag="&#xE721;"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Buscar por código, nombre, marca, modelo o ubicación"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource Selector}" Margin="10,0"
                                  ItemsSource="{Binding CategoriasFiltro}" SelectedItem="{Binding CategoriaFiltro}"
                                  ToolTip="Filtrar por categoría del equipo"/>
                        <ComboBox Grid.Column="2" Style="{StaticResource Selector}" Margin="0,0,10,0"
                                  ItemsSource="{Binding EstadosFiltro}" SelectedItem="{Binding EstadoFiltro}"
                                  ToolTip="Filtrar por estado operativo"/>
                        <Button Grid.Column="3" Style="{StaticResource Boton.Contorno}"
                                Command="{Binding LimpiarFiltrosCommand}" Content="Limpiar"/>
                    </Grid>
                </Border>

                <!-- ===================== Inventario ===================== -->
                <Border Style="{StaticResource Tarjeta}" Padding="16,14">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Equipos}" MaxHeight="640"
                                  MouseDoubleClick="Equipos_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="140" Header="CÓDIGO">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding CodigoInventario}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="{Binding NumeroSerie}" FontSize="10.5"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="2*" Header="EQUIPO">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Nombre}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Marca, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Modelo, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Binding="{Binding Categoria}" Header="CATEGORÍA" Width="170"/>

                                <DataGridTextColumn Binding="{Binding Ubicacion}" Header="UBICACIÓN" Width="170"/>

                                <DataGridTemplateColumn Width="140" Header="ESTADO">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                    Background="{Binding Estado, Converter={StaticResource CvtEstadoEquipoFondo}}"
                                                    BorderBrush="{Binding Estado, Converter={StaticResource CvtEstadoEquipoColor}}">
                                                <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource Chip.Texto}"
                                                           Foreground="{Binding Estado, Converter={StaticResource CvtEstadoEquipoColor}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="170" Header="PRÓX. MANTENIMIENTO">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="{Binding ProximoMantenimiento, Mode=OneWay, StringFormat=dd MMM yyyy}"
                                                           Visibility="{Binding ProximoMantenimiento, Converter={StaticResource CvtNuloVisible}}"/>
                                                <Border CornerRadius="6" Padding="6,2" Margin="7,0,0,0" VerticalAlignment="Center"
                                                        Background="{StaticResource DangerSoftBrush}"
                                                        Visibility="{Binding PreventivoVencido, Converter={StaticResource CvtBoolVisible}}">
                                                    <TextBlock Text="vencido" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{StaticResource DangerBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="140" Header="VIDA ÚTIL">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Text="{Binding PorcentajeVida, Mode=OneWay, StringFormat={}{0:N0} %}"
                                                           Foreground="{Binding PorcentajeVida, Converter={StaticResource CvtCargaColor}}"/>
                                                <ProgressBar Height="5" Margin="0,5,0,0" Minimum="0" Maximum="100"
                                                             Value="{Binding PorcentajeVida, Mode=OneWay}"
                                                             Background="{StaticResource DividerBrush}"
                                                             Foreground="{Binding PorcentajeVida, Converter={StaticResource CvtCargaColor}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource Boton.Icono.Contorno}" Padding="6" FontSize="13"
                                                        ToolTip="Abrir la hoja de vida del equipo"
                                                        Command="{Binding DataContext.VerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}"/>
                                                </Button>
                                                <Button Style="{StaticResource Boton.Icono.Contorno}" Padding="6" FontSize="13"
                                                        Margin="7,0,0,0" ToolTip="Eliminar del inventario"
                                                        Visibility="{Binding DataContext.PuedeEditar, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource CvtBoolVisible}}"
                                                        Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                                               Foreground="{StaticResource DangerBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ctrl:EmptyState Grid.Row="0"
                                         Icono="&#xE721;" Titulo="Sin equipos que mostrar"
                                         Mensaje="No hay registros que coincidan con la búsqueda ni con los filtros seleccionados."
                                         TextoAccion="Nuevo equipo" AccionCommand="{Binding NuevoCommand}"
                                         Visibility="{Binding Equipos, Converter={StaticResource CvtColeccionVacia}}"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Diálogo de alta de equipo -->
        <ctrl:Dialogo Visible="{Binding DialogoAbierto}" Titulo="Nuevo equipo biomédico"
                      Subtitulo="Complete la hoja de vida inicial; el código de inventario debe ser único en la institución"
                      Icono="&#xE710;" Ancho="660" Contenido="{Binding ContenidoDialogo}"
                      TextoConfirmar="Guardar equipo" TextoCancelar="Cancelar"
                      ConfirmarCommand="{Binding GuardarCommand}"
                      CancelarCommand="{Binding CancelarCommand}"/>

        <!-- Diálogo de confirmación de eliminación -->
        <ctrl:Dialogo Visible="{Binding ConfirmacionAbierta}" Titulo="Eliminar equipo"
                      Subtitulo="Confirme la baja del activo del inventario biomédico"
                      Icono="&#xE74D;" Ancho="520" EsPeligro="True"
                      Contenido="{Binding MensajeConfirmacion}"
                      TextoConfirmar="Eliminar equipo" TextoCancelar="Conservar"
                      ConfirmarCommand="{Binding ConfirmarEliminacionCommand}"
                      CancelarCommand="{Binding CancelarCommand}"/>
    </Grid>
</UserControl>
