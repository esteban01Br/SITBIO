<UserControl x:Class="SITBIO_Desktop.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:mod="clr-namespace:SITBIO_Desktop.Models"
             d:DesignHeight="880" d:DesignWidth="1440">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="AVisibilidad"/>

        <!-- Plantilla de las filas del menú: ContentPresenter con Stretch para que
             la fila se mida con ancho disponible (recorta textos largos) y quede
             alineada a la izquierda en todos los módulos -->
        <ControlTemplate x:Key="PlantillaMenu" TargetType="Button">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
        </ControlTemplate>

        <Style x:Key="BotonMenu" TargetType="Button" BasedOn="{StaticResource Boton}">
            <Setter Property="Template" Value="{StaticResource PlantillaMenu}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== BARRA LATERAL ==================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="252"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MenuAbierto}" Value="False">
                            <Setter Property="Width" Value="76"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel LastChildFill="True">

                <!-- Logotipo -->
                <Grid DockPanel.Dock="Top" Height="74" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="11" Margin="20,0,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0B6FA4" Offset="0"/>
                                <GradientStop Color="#12B5A6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE95E;" FontFamily="{StaticResource IconFont}" FontSize="19"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0"
                                Visibility="{Binding MenuAbierto, Converter={StaticResource AVisibilidad}}">
                        <TextBlock Text="SITBIO" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Gestión biomédica" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Cierre de sesión -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="14,13" Background="{StaticResource SurfaceAltBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource PrimarySoftBrush}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding InicialesUsuario}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding MenuAbierto, Converter={StaticResource AVisibilidad}}">
                                <TextBlock Text="{Binding NombreUsuario}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding RolUsuario}" FontSize="10.5"
                                           Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                           MaxWidth="150"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Style="{StaticResource Boton.Fantasma}" Padding="9,7"
                                Command="{Binding CerrarSesionCommand}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE8A0;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource DangerBrush}"/>
                                <TextBlock Text="Cerrar sesión" FontSize="12" Margin="9,0,0,0"
                                           Foreground="{StaticResource DangerBrush}"
                                           Visibility="{Binding MenuAbierto, Converter={StaticResource AVisibilidad}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Navegación -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,6,0,10">
                    <ItemsControl ItemsSource="{Binding Menu}" Margin="0,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavGrupo}">
                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Margin" Value="0,16,0,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.MenuAbierto, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                    <Setter Property="Margin" Value="0,8,0,0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Titulo}" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="22,0,0,7"
                                               Visibility="{Binding DataContext.MenuAbierto, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AVisibilidad}}"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                                <Button Style="{StaticResource BotonMenu}"
                                                        Margin="8,1" HorizontalAlignment="Stretch"
                                                        Command="{Binding DataContext.NavegarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Border x:Name="Fondo" CornerRadius="9" Padding="13,10"
                                                            HorizontalAlignment="Stretch"
                                                            BorderThickness="3,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Activo}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Icono}"
                                                                       FontFamily="{StaticResource IconFont}" FontSize="15"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Activo}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock Grid.Column="1" Text="{Binding Titulo}"
                                                                       FontSize="13" Margin="11,0,0,0" MinWidth="0"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding DataContext.MenuAbierto, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AVisibilidad}}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Activo}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <Grid Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                  Visibility="{Binding DataContext.MenuAbierto, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AVisibilidad}}">
                                                                <Border Background="{StaticResource WarningSoftBrush}"
                                                                        CornerRadius="5" Padding="5,2"
                                                                        Visibility="{Binding EnDesarrollo, Converter={StaticResource AVisibilidad}}">
                                                                    <TextBlock Text="próximamente" FontSize="8"
                                                                               Foreground="{StaticResource WarningBrush}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== ÁREA PRINCIPAL ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Border Grid.Row="0" Background="{StaticResource TopBarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Boton.Icono}" Command="{Binding AlternarMenuCommand}"
                                Content="&#xE700;" FontSize="16" ToolTip="Contraer o expandir el menú"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TituloModulo}" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="6,2" Margin="9,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Usuario.PrimeroIngreso, Converter={StaticResource AVisibilidad}}">
                                    <TextBlock Text="primera sesión" FontSize="9.5" Foreground="{StaticResource AccentDarkBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SubtituloModulo}" Style="{StaticResource Texto.Auxiliar}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Institución activa (multi-tenant) -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding EsAdministrador, Converter={StaticResource AVisibilidad}}">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentSoftBrush}"
                                    Margin="0,0,10,0">
                                <TextBlock Text="&#xE825;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource AccentDarkBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ComboBox Style="{StaticResource Selector}" Width="260"
                                      ItemsSource="{Binding Tenants}"
                                      SelectedItem="{Binding Institucion, Mode=OneWay}"
                                      DisplayMemberPath="Nombre"
                                      SelectionChanged="Tenant_SelectionChanged"
                                      ToolTip="Institución activa. Cada tenant opera con sus datos aislados."/>
                            <TextBlock Text="tenant activo" Style="{StaticResource Texto.Auxiliar}" Margin="9,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding EsAdministrador, Converter={StaticResource CvtNoBoolVisible}}">
                            <Border CornerRadius="7" Padding="9,5" Background="{StaticResource PrimarySofterBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE825;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="{StaticResource PrimaryBrush}" Margin="0,1,7,0"/>
                                    <TextBlock Text="{Binding Institucion.Nombre}" FontSize="11.5"
                                               Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Notificaciones y usuario -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Margin="0,0,14,0">
                            <Button Style="{StaticResource Boton.Icono.Contorno}" Padding="9"
                                    Command="{Binding AlternarNotificacionesCommand}"
                                    Content="&#xE781;" FontSize="15" ToolTip="Notificaciones"/>
                            <Border Background="{StaticResource DangerBrush}" CornerRadius="8" Padding="4,1"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-4,-4,0,0"
                                    Visibility="{Binding NotificacionesNoLeidas, Converter={StaticResource AVisibilidad}}">
                                <TextBlock Text="{Binding NotificacionesNoLeidas}" FontSize="9" FontWeight="Bold"
                                           Foreground="White" MinWidth="9" TextAlignment="Center"/>
                            </Border>

                            <Popup Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{Binding NotificacionesAbiertas, Mode=TwoWay}" StaysOpen="False"
                                   VerticalOffset="8" HorizontalOffset="-330">
                                <Border Width="360" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                                        Margin="0,4,0,0" MaxHeight="420">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" Color="#0E1B2C"/>
                                    </Border.Effect>
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="16,14,12,10">
                                            <TextBlock Text="Notificaciones" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="Marcar todas" Style="{StaticResource Boton.Fantasma}"
                                                    FontSize="11.5" Padding="6,3" HorizontalAlignment="Right"
                                                    Command="{Binding MarcarLeidasCommand}"/>
                                        </Grid>
                                        <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource DividerBrush}"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="330">
                                            <ItemsControl ItemsSource="{Binding Notificaciones}" Margin="0,0,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type mod:Notificacion}">
                                                        <StackPanel Orientation="Horizontal" Margin="16,9">
                                                            <Border Width="28" Height="28" CornerRadius="8"
                                                                    Background="{StaticResource InfoSoftBrush}">
                                                                <TextBlock Text="{Binding Icono}"
                                                                           FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                           Foreground="{StaticResource InfoBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding Titulo}" FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding Mensaje}" FontSize="11.5"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap" MaxWidth="270"/>
                                                                <TextBlock Text="{Binding Fecha, Converter={StaticResource CvtFechaRelativa}}"
                                                                           FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                                                           Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource PrimaryBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding InicialesUsuario}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contenido del módulo -->
            <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}">
                <ContentControl Content="{Binding VistaActual}" Focusable="False"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
