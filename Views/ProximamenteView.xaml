<UserControl x:Class="SITBIO_Desktop.Views.ProximamenteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:ctrl="clr-namespace:SITBIO_Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProximamenteViewModel}"
             d:DesignHeight="980" d:DesignWidth="1240">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,34">

            <!-- ===================== Encabezado ===================== -->
            <ctrl:PageHeader Titulo="{Binding Titulo}"
                             Subtitulo="{Binding Subtitulo}"
                             Icono="{Binding Icono}"/>

            <!-- ===================== Estado del módulo ===================== -->
            <Border Style="{StaticResource Tarjeta}" Padding="16,16" Margin="0,18,0,0">
                <ctrl:EmptyState Icono="{Binding Icono}"
                                 Titulo="Módulo en construcción"
                                 Mensaje="{Binding Mensaje}"
                                 TextoAccion="Volver al panel de control"
                                 AccionCommand="{Binding VolverCommand}"/>
            </Border>

            <!-- ===================== Entregables ===================== -->
            <Border Style="{StaticResource Tarjeta}" Padding="20,16" Margin="0,18,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="Qué entregará esta fase" Style="{StaticResource Texto.Tarjeta}"/>
                        <TextBlock Text="Funciones comprometidos para la siguiente versión del producto"
                                   Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Coleccion}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Entregable}">
                                <Border CornerRadius="10" Padding="15,13" Margin="0,14,14,0"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34" Height="34" CornerRadius="10"
                                                Background="{StaticResource PrimarySoftBrush}">
                                            <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Titulo}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Descripcion}" FontSize="11.5" TextWrapping="Wrap"
                                                       Margin="0,4,0,0" LineHeight="17"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ===================== Resumen y retorno ===================== -->
            <Border Background="{StaticResource PrimarySofterBrush}"
                    BorderBrush="{StaticResource PrimarySoftBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16,13" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Resumen de la fase" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                        <TextBlock Text="{Binding Resumen}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource Boton.Acento}" Padding="15,9"
                            VerticalAlignment="Center" Command="{Binding VolverCommand}"
                            ToolTip="Regresa al panel de control">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,7,0"/>
                            <TextBlock Text="Volver al panel"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
