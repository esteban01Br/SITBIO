<UserControl x:Class="SITBIO_Desktop.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReportesViewModel}"
             xmlns:vm="clr-namespace:SITBIO_Desktop.ViewModels"
             xmlns:ctrl="clr-namespace:SITBIO_Desktop.Controls"
             d:DesignHeight="1650" d:DesignWidth="1240">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,34">

            <!-- ===================== Encabezado ===================== -->
            <ctrl:PageHeader Titulo="Reportes e indicadores"
                             Subtitulo="{Binding Subtitulo}"
                             Icono="&#xE9F9;"
                             Contador="{Binding Contador}"
                             NotaContador="{Binding NotaContador}">
                <ctrl:PageHeader.Acciones>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Boton.Contorno}" Padding="13,9" Margin="0,0,9,0"
                                Command="{Binding ExportarIndicadoresExcelCommand}"
                                IsEnabled="{Binding PuedeExportar}"
                                ToolTip="Descarga los indicadores del periodo en Excel (queda en la bitácora)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource SuccessBrush}" Margin="0,1,7,0"/>
                                <TextBlock Text="Indicadores Excel"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Boton.Contorno}" Padding="13,9" Margin="0,0,9,0"
                                Command="{Binding ExportarIndicadoresPdfCommand}"
                                IsEnabled="{Binding PuedeExportar}"
                                ToolTip="Descarga los indicadores del periodo en PDF (queda en la bitácora)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource DangerBrush}" Margin="0,1,7,0"/>
                                <TextBlock Text="Indicadores PDF"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Boton.Contorno}" Padding="13,9" Margin="0,0,9,0"
                                Command="{Binding ExportarOrdenesExcelCommand}"
                                IsEnabled="{Binding PuedeExportar}"
                                ToolTip="Descarga en Excel las órdenes del periodo seleccionado">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource SuccessBrush}" Margin="0,1,7,0"/>
                                <TextBlock Text="Órdenes Excel"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Boton.Contorno}" Padding="13,9"
                                Command="{Binding ExportarOrdenesPdfCommand}"
                                IsEnabled="{Binding PuedeExportar}"
                                ToolTip="Descarga en PDF las órdenes del periodo seleccionado">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource DangerBrush}" Margin="0,1,7,0"/>
                                <TextBlock Text="Órdenes PDF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ctrl:PageHeader.Acciones>
            </ctrl:PageHeader>

            <!-- ===================== Selector de periodo ===================== -->
            <Border Style="{StaticResource Tarjeta}" Padding="16,14" Margin="0,2,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource PrimarySoftBrush}">
                        <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Periodo de análisis" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                        <TextBlock Text="Las series y las gráficas se recalculan al cambiar el periodo"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <ComboBox Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource Selector}"
                              ItemsSource="{Binding Periodos}"
                              SelectedItem="{Binding PeriodoSeleccionado}"
                              HorizontalAlignment="Left" MinWidth="220"
                              ToolTip="Rango de tiempo que alimenta los indicadores y las gráficas"/>
                </Grid>
            </Border>

            <!-- ===================== Indicadores ===================== -->
            <ItemsControl ItemsSource="{Binding Kpis}" Margin="0,18,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TarjetaKpi}">
                        <ctrl:KpiCard Margin="0,0,14,0"
                                      Titulo="{Binding Titulo}"
                                      Valor="{Binding Valor}"
                                      Unidad="{Binding Unidad}"
                                      Icono="{Binding Icono}"
                                      IconoColor="{Binding IconoColor}"
                                      IconoFondo="{Binding IconoFondo}"
                                      DeltaTexto="{Binding Delta}"
                                      DeltaIcono="{Binding DeltaIcono}"
                                      DeltaColor="{Binding DeltaColor}"
                                      DeltaFondo="{Binding DeltaFondo}"
                                      Leyenda="{Binding Leyenda}"
                                      Ayuda="{Binding Ayuda}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===================== Gráficas (fila 1) ===================== -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Mantenimientos por mes -->
                <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,14,0" Padding="20,18">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Mantenimientos por mes" Style="{StaticResource Texto.Tarjeta}"/>
                                <TextBlock Text="Órdenes de trabajo registradas en cada mes del periodo"
                                           Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="7"
                                    Padding="9,5" Background="{StaticResource PrimarySoftBrush}">
                                <TextBlock Text="preventivo + correctivo" FontSize="11"
                                           Foreground="{StaticResource PrimaryDarkBrush}"/>
                            </Border>
                        </Grid>

                        <StackPanel>
                            <ctrl:GraficaBarras ItemsSource="{Binding Mantenimientos}"
                                                ColorBarra="{StaticResource PrimaryBrush}"
                                                Altura="176" AnchoBarra="26" Formato="0"/>
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,0"/>
                            <TextBlock Text="Cada columna cuenta las órdenes preventivas y correctivas del mes; cambie el periodo para ver más o menos meses."
                                       Style="{StaticResource Texto.Auxiliar}" Margin="0,11,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Órdenes por estado -->
                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="20,18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Órdenes por estado" Style="{StaticResource Texto.Tarjeta}"/>
                            <TextBlock Text="Distribución actual del flujo de trabajo"
                                       Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ctrl:GraficaDona ItemsSource="{Binding PorEstado}"
                                          TextoCentro="{Binding Contador}"
                                          SubtextoCentro="órdenes"
                                          Tamanio="168"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===================== Gráficas (fila 2) ===================== -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cumplimiento de SLA por mes -->
                <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,14,0" Padding="20,18">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Cumplimiento de SLA por mes" Style="{StaticResource Texto.Tarjeta}"/>
                                <TextBlock Text="Porcentaje de órdenes atendidas dentro del plazo comprometido"
                                           Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="7"
                                    Padding="9,5" Background="{StaticResource AccentSoftBrush}">
                                <TextBlock Text="meta ≥ 90,0 %" FontSize="11"
                                           Foreground="{StaticResource AccentDarkBrush}"/>
                            </Border>
                        </Grid>

                        <StackPanel>
                            <ctrl:GraficaLinea ItemsSource="{Binding CumplimientoMensual}"
                                               ColorLinea="{StaticResource PrimaryBrush}"
                                               Altura="164" Formato="0.0"/>
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,0"/>
                            <TextBlock Text="Serie derivada de las órdenes del mes: se considera incumplida aquella que supera su tiempo de respuesta SLA."
                                       Style="{StaticResource Texto.Auxiliar}" Margin="0,11,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Órdenes por tipo -->
                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="20,18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Órdenes por tipo" Style="{StaticResource Texto.Tarjeta}"/>
                            <TextBlock Text="Composición del trabajo de mantenimiento"
                                       Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ctrl:GraficaDona ItemsSource="{Binding PorTipo}"
                                          TextoCentro="{Binding Contador}"
                                          SubtextoCentro="clasificadas"
                                          Tamanio="168"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===================== Resumen de indicadores ===================== -->
            <Border Style="{StaticResource Tarjeta}" Padding="20,16,20,14" Margin="0,14,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Resumen de indicadores" Style="{StaticResource Texto.Tarjeta}"/>
                        <TextBlock Text="Valores actuales frente a las metas de gestión del programa de mantenimiento"
                                   Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Resumen}" MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="INDICADOR" Binding="{Binding Indicador}" Width="*"/>
                            <DataGridTextColumn Header="VALOR" Binding="{Binding Valor}" Width="150"/>
                            <DataGridTextColumn Header="UNIDAD" Binding="{Binding Unidad}" Width="120"/>
                            <DataGridTextColumn Header="META" Binding="{Binding Meta}" Width="240"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ===================== Últimas órdenes ===================== -->
            <Border Style="{StaticResource Tarjeta}" Padding="20,16,20,8" Margin="0,14,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Órdenes más recientes" Style="{StaticResource Texto.Tarjeta}"/>
                        <TextBlock Text="Las 10 últimas órdenes de trabajo de la institución; doble clic para abrir el detalle"
                                   Style="{StaticResource Texto.Auxiliar}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding OrdenesRecientes}" MaxHeight="440"
                              MouseDoubleClick="OrdenesRecientes_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="132" Header="CÓDIGO">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Codigo}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding FechaSolicitud, StringFormat=dd MMM HH:mm}"
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*" Header="EQUIPO / SOLICITUD">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding EquipoNombre, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding EquipoUbicacion, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Width="112" Header="TIPO" Binding="{Binding TipoTexto}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{Binding Tipo, Converter={StaticResource CvtTipoColor}}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="104" Header="PRIORIDAD">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                Background="{Binding Prioridad, Converter={StaticResource CvtPrioridadFondo}}"
                                                BorderBrush="{Binding Prioridad, Converter={StaticResource CvtPrioridadColor}}">
                                            <TextBlock Text="{Binding PrioridadTexto}" Style="{StaticResource Chip.Texto}"
                                                       Foreground="{Binding Prioridad, Converter={StaticResource CvtPrioridadColor}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="128" Header="ESTADO">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" BorderThickness="1"
                                                Background="{Binding Estado, Converter={StaticResource CvtOrdenFondo}}"
                                                BorderBrush="{Binding Estado, Converter={StaticResource CvtOrdenColor}}">
                                            <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource Chip.Texto}"
                                                       Foreground="{Binding Estado, Converter={StaticResource CvtOrdenColor}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="150" Header="RESPUESTA SLA">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                                       Text="{Binding HorasRestantes, StringFormat={}{0:N0} h restantes}"
                                                       Foreground="{Binding ProgresoSLA, Converter={StaticResource CvtCargaColor}}"/>
                                            <ProgressBar Height="5" Margin="0,5,0,0"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding ProgresoSLA, Mode=OneWay}"
                                                         Background="{StaticResource DividerBrush}"
                                                         Foreground="{Binding ProgresoSLA, Converter={StaticResource CvtCargaColor}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ===================== Nota normativa ===================== -->
            <Border Background="{StaticResource InfoSoftBrush}"
                    BorderBrush="{StaticResource InfoBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16,13" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource InfoBrush}">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Trazabilidad normativa" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Los informes se elaboran conforme a la Resolución 3100 de 2019 y a las directrices del INVIMA para la gestión técnica de equipos biomédicos. Cada exportación que realice desde este módulo queda automáticamente registrada en la bitácora de auditoría de la institución, con usuario, fecha y archivo generado."
                                   FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
